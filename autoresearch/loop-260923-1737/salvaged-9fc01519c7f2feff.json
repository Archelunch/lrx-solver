                  0
                ]
              ]
            ],
            "n"
          ]
        ],
        [
          "or",
          [
            "ne",
            "b",
            [
              "add",
              "r0",
              1
            ]
          ],
          [
            "ge",
            "r0",
            [
              "sub",
              "m",
              1
            ]
          ],
          [
            "le",
            [
              "mul",
              2,
              [
                "sub",
