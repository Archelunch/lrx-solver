          "m"
        ],
        [
          "eq",
          "b",
          [
            "sub",
            "r0",
            1
          ]
        ]
      ],
      "do": "X",
      "set": {
        "r0": [
          "add",
          "r0",
          1
        ]
      }
    },
    {
      "if": [
        "and",
        [
          "eq",
          "csorted",
          0
        ],
        [
          "eq",
          "a",
          "r0"
        ],
        [
          "gt",
          "r0",
          1
        ],
        [
          "le",
          "r0",
          "m"
        ],
        [
          "eq",
          "last",
          [
            "sub",
            "r0",
            1
