{
  "kind": "rules",
  "name": "home near token 1 then insert",
  "notes": "One rule change: the early far-predecessor X becomes a home-L when r0=0 and token 1 lies in the near half. pos1 falls each step, so no cycle. Once token 1 is at the front, the existing XL/RX insertion and csorted finish are unchanged. Aimed at m8r3 states that otherwise set r0=2 and carry token 1 the long way.",
  "rules": [
    {
      "if": [
        "and",
        [
          "eq",
          "r2",
          1
        ],
        [
          "eq",
          "r3",
          2
        ]
      ],
      "do": "X",
      "set": {
        "r2": 0
      }
    },
    {
      "if": [
        "eq",
        "r2",
        1
      ],
      "do": "L",
      "set": {
        "r2": 0
      }
    },
    {
      "if": [
        "and",
        "csorted",
        [
          "le",
          [
            "mul",
            2,
            "pos1"
          ],
          "n"
        ]
      ],
      "do": "L"
    },
    {
      "if": [
        "and",
        [
          "eq",
          "csorted",
          0
        ],
        [
          "eq",
          "r0",
          0
        ],
        [
          "gt",
          "pos1",
          0
        ],
