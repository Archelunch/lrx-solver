def _zero_orders(state, cut):
    n = len(state)
    _, free = _free_slots(n, cut)
    k = len(free)
    slots = list(range(k))
    orders = [slots, list(reversed(slots))]
    if k > 1:
        orders.append(slots[1:] + slots[:1])
        inter = []
        lo, hi = 0, k - 1
        while lo <= hi:
            inter.append(lo)
            if lo != hi:
