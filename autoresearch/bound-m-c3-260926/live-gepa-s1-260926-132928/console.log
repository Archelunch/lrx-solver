    _POOLS[key] = words
    return words


def _budget(m, r):
    return m * (m + 1) // 2 + (r - 1) * (m - 2)


def _refine(v, origins):
    out, j = [], 0
    for x in v:
        if x:
            out.append(x)
        else:
            out.extend([0] * origins[j])
            j += 1
    return out


def _sweep_words(v, deadline):
    n, m = len(v), max(v)
    r = n - m
    if r <= 4:
        perms = list(itertools.permutations(range(r)))
    else:
        perms = [[(s + i) % r for i in range(r)] for s in range(r)] + [
            [(s + r - 1 - i) % r for i in range(r)] for s in range(r)
        ]
    words = set()
    for t in range(n):
        if _time.process_time() > deadline:
            break
        for perm in perms:
            for rem in _lifts(v, t, perm, m, r):
                for c_start in (0, t) if t != 0 else (0,):
                    for mode in ('L', 'R', 'greedy', 'greedy_R', 'bounce_L', 'bounce_R'):
                        w = _sweep(v, rem, t, mode, c_start=c_start)
                        if w is not None:
                            w = _reduce(w)
                            if len(w) <= 4000:
                                words.add(w)
    return sorted(words, key=lambda w: (len(w), w))


def _pareto(priced):
    best = {}
    for w, B, beta in priced:
        key = (B,) + tuple(beta)
        if key not in best or (len(w), w) < (len(best[key]), best[key]):
            best[key] = w
    keys = sorted(best)
    keep = []
    for x in keys:
        if not any(all(p <= q for p, q in zip(y, x)) for y in keep):
            keep.append(x)
    return [(best[x], x[0], list(x[1:])) for x in keep]


def _simplex(A, b, c):
    rows, cols = len(A), len(c)
    T = []
    for i in range(rows):
        s = -1.0 if b[i] < 0 else 1.0
        T.append([s * x for x in A[i]] + [1.0 if r == i else 0.0 for r in range(rows)] + [s * b[i]])
    basis = list(range(cols, cols + rows))

    def pivot(r, j):
        p = T[r][j]
        T[r] = [x / p for x in T[r]]
        for i in range(rows):
            if i != r and abs(T[i][j]) > 1e-15:
                f = T[i][j]
                T[i] = [x - f * y for x, y in zip(T[i], T[r])]
        basis[r] = j

    def run(cost, allowed):
        for _ in range(2500):
            enter = None
            for j in allowed:
                if j in basis:
                    continue
                if cost[j] - sum(cost[basis[i]] * T[i][j] for i in range(rows)) < -EPS:
                    enter = j
                    break
            if enter is None:
                return True
            cand = [i for i in range(rows) if T[i][enter] > EPS]
            if not cand:
                return False
            r = min(cand, key=lambda i: (T[i][-1] / T[i][enter], basis[i]))
            pivot(r, enter)
        return False

    if not run([0.0] * cols + [1.0] * rows, range(cols + rows)):
        return None
    if sum(T[i][-1] for i in range(rows) if basis[i] >= cols) > 1e-7:
        return None
    for r in range(rows):
        if basis[r] >= cols:
            j = next((j for j in range(cols) if abs(T[r][j]) > EPS and j not in basis), None)
            if j is not None:
                pivot(r, j)
    if not run(list(c) + [0.0] * rows, range(cols)):
        return None
    x = [0.0] * cols
    for i, j in enumerate(basis):
        if j < cols:
            x[j] = T[i][-1]
    return x, sum(ci * xi for ci, xi in zip(c, x))


def _leaf_lp(cols, origins, lo, hi, s, m):
    k = len(lo)
    n = len(cols)
    bnd = [j for j in range(k) if hi[j] is not None]
    T = _budget(m, sum(lo))
    cost = [B + sum(b * (l - o) for b, l, o in zip(beta, lo, origins)) for _, B, beta in cols]
    A = []
    for j in range(k):
        A.append([beta[j] for _, _, beta in cols] + [-1.0 if bj == j else 0.0 for bj in bnd]
                 + [1.0 if i == j else 0.0 for i in range(k)])
    A.append([1.0] * n + [0.0] * (len(bnd) + k))
    c = cost + [hi[j] - lo[j] for j in bnd] + [0.0] * k
    out = _simplex(A, [float(s)] * k + [1.0], c)
    if out is None:
        return False, None
    x, val = out
    return val < T + 1 - 1e-6, x[:n]


def _leaf(cols, origins, weights, picks=None):
    order = sorted(range(len(cols)), key=lambda i: (-weights[i], cols[i][1], i))
    words = [cols[i][0] for i in order if weights[i] > 1e-12]
    for i in order:
        if len(words) >= LEAF_WORDS:
            break
        if cols[i][0] not in words:
            words.append(cols[i][0])
    res = {'words': words[:LEAF_WORDS], 'origins': list(origins)}
    if picks is not None and any(p != 0 for p in picks):
        res['picks'] = list(picks)
    return res


def _columns(v, origins, deadline, cache):
    key = tuple(origins)
    if key in cache:
        return cache[key]
    ref = _refine(v, origins)
    raw = []
    for w in _sweep_words(ref, deadline):
        p = _price_all_zeros(ref, w)
        if p is not None:
            raw.append((w, p[0], p[1]))

    # Find the pick choice (which atom in each block is stretched) that minimizes sum of min slopes
    k = len(origins)
    best_picks = [0] * k
    best_cols = []
    min_score = float('inf')

    # Test candidate pick configurations
    cand_picks = []
    # Pick first atom, pick last atom, pick center atom for blocks with o_j > 1
    ranges = []
    for o in origins:
        if o == 1:
            ranges.append([0])
        elif o == 2:
            ranges.append([0, 1])
        else:
            ranges.append([0, o // 2, o - 1])

    for p_tuple in itertools.product(*ranges):
        cand_picks.append(list(p_tuple))

    for p_choice in cand_picks:
        # map local block pick to global index
        g_picks = [sum(origins[:j]) + p_choice[j] for j in range(k)]
        priced = []
        for w, B, all_b in raw:
            beta = [all_b[gp] for gp in g_picks]
            priced.append((w, B, beta))
        pareto_cols = _pareto(priced)
        if pareto_cols:
            score = sum(min(beta[j] for _, _, beta in pareto_cols) for j in range(k))
            if score < min_score:
                min_score = score
                best_picks = p_choice
                best_cols = pareto_cols

    cache[key] = (best_cols, best_picks)
    return cache[key]


def _staircase(v, m, k, axis, deadline, cache, fixed_splits=None):
    s = m - 2
    leaves, l = [], 1
    base_origins = [1] * k
    base_lo = [1] * k
    base_hi = [None] * k
    if fixed_splits:
        for fa, (flo, fhi, fo) in fixed_splits.items():
            base_origins[fa] = fo
            base_lo[fa] = flo
            base_hi[fa] = fhi

    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        origins = list(base_origins)
        origins[axis] = min(l, MAX_ORIGIN)
        cols, picks = _columns(v, origins, deadline, cache)
        if not cols:
            return None
        lo = list(base_lo)
        lo[axis] = l
        hi = list(base_hi)
        hi[axis] = None
        ok, w = _leaf_lp(cols, origins, lo, hi, s, m)
        if ok:
            leaves.append((_leaf(cols, origins, w, picks), None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree
        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None
        lo_h, hi_h, best = l, MAX_CUT, None
        while lo_h <= hi_h:
            mid = (lo_h + hi_h) // 2
            hi = list(base_hi)
            hi[axis] = mid
            ok, w = _leaf_lp(cols, origins, lo, hi, s, m)
            if ok:
                best, lo_h = (mid, w), mid + 1
            else:
                hi_h = mid - 1
        if best is None:
            return None
        leaves.append((_leaf(cols, origins, best[1], picks), best[0]))
        l = best[0] + 1
    return None


def _certify_root(v, deadline):
    words = pool(v)
    if not words:
        return {'words': []}

    word_list = list(words.keys())
    m = max(v)
    k = sum(1 for x in v if x == 0)
    T = _budget(m, k)

    costs = []
    for w in word_list:
        B, beta = words[w]
        costs.append([B - T] + [b - (m - 2) for b in beta])

    n_words = len(word_list)
    dim = k + 1
    hull_indices = set()

    for d in range(dim):
        hull_indices.add(min(range(n_words), key=lambda i: (costs[i][d], max(costs[i]))))

    for j in range(1, dim):
        pts = sorted(range(n_words), key=lambda i: (costs[i][0], costs[i][j]))
        lower = []
        for p in pts:
            while len(lower) >= 2:
                p1, p2 = lower[-2], lower[-1]
                dx1, dy1 = costs[p2][0] - costs[p1][0], costs[p2][j] - costs[p1][j]
                dx2, dy2 = costs[p][0] - costs[p1][0], costs[p][j] - costs[p1][j]
                if dx1 * dy2 - dy1 * dx2 <= 0:
                    lower.pop()
                else:
                    break
            lower.append(p)
        for idx in lower:
            hull_indices.add(idx)

    for j in range(1, dim):
        for ratio in (0.1, 0.25, 0.5, 1.0, 2.0, 4.0, 10.0):
            best_idx = min(range(n_words), key=lambda i: costs[i][0] + ratio * costs[i][j])
            hull_indices.add(best_idx)

    for alpha in (1.5, 3.0):
        for start_mode in ('min_max', 'min_b'):
            if start_mode == 'min_max':
                cur_idx = min(range(n_words), key=lambda i: (max(costs[i]), costs[i][0]))
            else:
                cur_idx = min(range(n_words), key=lambda i: (costs[i][0], max(costs[i])))
            cur_vec = list(costs[cur_idx])
            hull_indices.add(cur_idx)
            for it in range(1, 40):
                mx = max(cur_vec)
                exps = [math.exp(min(50.0, alpha * (val - mx))) for val in cur_vec]
                tot = sum(exps)
                weights = [e / tot for e in exps]
                best_i = min(range(n_words), key=lambda i: sum(weights[d] * costs[i][d] for d in range(dim)))
                hull_indices.add(best_i)
                gamma = 2.0 / (it + 2)
                for d in range(dim):
                    cur_vec[d] = (1.0 - gamma) * cur_vec[d] + gamma * costs[best_i][d]

    ordered = sorted(hull_indices, key=lambda i: (max(costs[i]), costs[i][0], sum(costs[i])))
    selected_indices = list(ordered[:KEEP])
    if len(selected_indices) < KEEP:
        by_max = sorted(range(n_words), key=lambda i: (max(costs[i]), costs[i][0]))
        for idx in by_max:
            if idx not in selected_indices:
                selected_indices.append(idx)
                if len(selected_indices) >= KEEP:
                    break

    res = [word_list[i] for i in selected_indices[:KEEP]]
    return {'words': res}


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
    m, k = max(v), sum(1 for x in v if x == 0)

    out = _certify_root(v, deadline)
    root = {'words': out['words'], 'origins': [1] * k}
    base = []
    for w in out['words']:
        p = price(v, w)
        if p is not None:
            base.append((w, p[0], p[1]))
    if base and _leaf_lp(base, [1] * k, [1] * k, [None] * k, m - 2, m)[0]:
        return {'tree': root}

    cache = {}
    unit_p = _pareto([(w, B, beta) for w, (B, beta) in pool(v).items()]) if _time.process_time() < deadline else []
    if unit_p:
        cache[tuple([1] * k)] = (unit_p, [0] * k)

    load = [min(beta[j] for _, _, beta in unit_p) if unit_p else 0 for j in range(k)]
    sorted_axes = sorted(range(k), key=lambda j: (-load[j], j))

    # Phase 1: Try single axis staircases
    for axis in sorted_axes:
        if _time.process_time() > deadline:
            break
        tree = _staircase(v, m, k, axis, deadline, cache)
        if tree is not None:
            return {'tree': tree}

    # Phase 2: If single axis fails, try 2-axis split for top two bottleneck axes
    if k >= 2 and _time.process_time() + 0.6 < deadline:
        ax1, ax2 = sorted_axes[0], sorted_axes[1]
        for t1 in (2, 3, 4):
            if _time.process_time() > deadline:
                break
            # Split ax1 <= t1 and ax1 >= t1 + 1
            left_tree = _staircase(v, m, k, ax2, deadline, cache, fixed_splits={ax1: (1, t1, 1)})
            if left_tree is not None:
                o1_ge = min(t1 + 1, MAX_ORIGIN)
                right_tree = _staircase(v, m, k, ax2, deadline, cache, fixed_splits={ax1: (t1 + 1, None, o1_ge)})
                if right_tree is not None:
                    return {'tree': {'j': ax1, 't': t1, 'le': left_tree, 'ge': right_tree}}

    return {'tree': root}
