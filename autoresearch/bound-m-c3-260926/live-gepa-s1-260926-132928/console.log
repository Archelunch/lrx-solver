            origins = [1] * k
            origins[axis] = orig
            lo = [1] * k
            lo[axis] = l
            ok, leaf_data = _eval_leaf(v, origins, lo, [None] * k, s, m, deadline, raw_cache, pick_cache)
            if ok:
                pass_leaf = leaf_data
                break
        if pass_leaf is not None:
            leaves.append((pass_leaf, None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree
        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None

        lo_h, hi_h, best = l, MAX_CUT, None
        while lo_h <= hi_h and _time.process_time() < deadline:
            mid = (lo_h + hi_h) // 2
            hi = [None] * k
            hi[axis] = mid
            ok_mid = False
            mid_leaf = None
            for orig in range(min(l, MAX_ORIGIN), 0, -1):
                origins = [1] * k
                origins[axis] = orig
                lo = [1] * k
                lo[axis] = l
                ok, leaf_data = _eval_leaf(v, origins, lo, hi, s, m, deadline, raw_cache, pick_cache)
                if ok:
