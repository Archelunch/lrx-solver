            if res is not None:
                priced.append((w, res[0], res[1]))
        if priced:
            avg_beta = sum(sum(b) for _, _, b in priced) / len(priced)
            if best_cost is None or avg_beta < best_cost:
                best_cost = avg_beta
                best_p = p
                best_priced = priced

    cand_picks = [0, origins[offsets.index(offsets[0])] - 1] if origins[0] > 1 else [0]
    best_cand_priced = {}
    for p in range(origins[0]):
        test_picks = list(offsets)
        test_picks[0] += p
        pr = []
        for w in raw_words:
            res = _price_picks(ref, w, test_picks)
            if res is not None:
                pr.append((w, res[0], res[1]))
        best_cand_priced[p] = pr

    p_opt = min(best_cand_priced.keys(), key=lambda p: (
        sum(b[0] for _, _, b in best_cand_priced[p]) if best_cand_priced[p] else 1e9
    ))
    picks = list(offsets)
    picks[0] += p_opt
    priced = best_cand_priced[p_opt]

    best_map = {}
    for w, B, beta in priced:
        key = (B,) + tuple(beta)
