import itertools
import math
import time as _time

KEEP = 32
MAX_ORIGIN = 5
MAX_CUT = 12
MAX_STEPS = 12
LEAF_WORDS = 16
CPU_BUDGET = 2.45
EPS = 1e-9


def _reduce(word):
    out = []
    for ch in word:
        if out and out[-1] + ch in ('LR', 'RL', 'XX'):
            out.pop()
        else:
            out.append(ch)
    return ''.join(out)


def _lifts(v, t, perm, m, r):
    n = len(v)
    zeros = [p for p in range(n) if v[p] == 0]
    target = [0] * n
    for p in range(n):
        if v[p]:
            target[p] = (t + v[p] - 1) % n
    for i in range(r):
        target[zeros[i]] = (t + m + perm[i]) % n

    lift_bases = [
        [((target[p] - p + n // 2) % n) - n // 2 for p in range(n)]
    ]
    if n % 2 == 0:
        base2 = [((target[p] - p + n // 2 - 1) % n) - (n // 2 - 1) for p in range(n)]
        if base2 != lift_bases[0]:
            lift_bases.append(base2)

    res = []
    for rem_base in lift_bases:
        q = sum(rem_base) // n
        if q == 0:
            if rem_base not in res:
                res.append(rem_base)
            continue
        for rev_tie in (False, True):
            rem = list(rem_base)
            order = sorted(range(n), key=lambda p: (rem[p], -p if rev_tie else p), reverse=q > 0)
            for p in order[:abs(q)]:
                rem[p] -= n if q > 0 else -n
            if rem not in res:
                res.append(rem)
    return res


def _sweep(v, rem, t, mode, c_start=0, limit=4000):
    n = len(v)
    a, rem = list(v), list(rem)
    out = []
    c = 0
    if c_start != 0:
        d = c_start % n
        out.append('L' * d if d <= n - d else 'R' * (n - d))
        c = c_start % n

    def must_cross(x):
        return rem[x] - rem[(x + 1) % n] >= 2

    def cross(x):
        y = (x + 1) % n
        rx, ry = rem[x], rem[y]
        if a[x] or a[y]:
            out.append('X')
            a[x], a[y] = a[y], a[x]
        rem[x], rem[y] = ry + 1, rx - 1

    bounce_dir = 1 if mode == 'bounce_L' else -1
    bounce_steps = 0
    while any(rem) and len(out) < limit:
        if mode.startswith('greedy'):
            dirs = (1, -1) if mode == 'greedy' else (-1, 1)
            for dist in range(n):
                found = False
                for sgn in dirs:
                    pos = (c + sgn * dist) % n
                    if must_cross(pos):
                        out.append(('L' if sgn == 1 else 'R') * dist)
                        c = pos
                        found = True
                        break
                if found:
                    break
            else:
                return None
            cross(c)
            continue
        elif mode.startswith('bounce'):
            if must_cross(c):
                cross(c)
                if not any(rem):
                    break
            step_ch = 'L' if bounce_dir == 1 else 'R'
            out.append(step_ch)
            c = (c + bounce_dir) % n
            bounce_steps += 1
            if bounce_steps >= n - 1:
                bounce_dir = -bounce_dir
                bounce_steps = 0
            continue
        if must_cross(c):
            cross(c)
            if not any(rem):
                break
        out.append(mode)
        c = (c + (1 if mode == 'L' else -1)) % n
    if any(rem):
        return None
    d = (t - c) % n
    out.append('L' * d if d <= n - d else 'R' * (n - d))
    return ''.join(out)


def price(v, word):
    n, k = len(v), sum(1 for x in v if x == 0)
    a, j = [], 0
    for x in v:
        if x:
            a.append(x)
        else:
            j += 1
            a.append(-j)
    segs, A, q, d, cz, c = [], [0] * k, 0, 0, [0] * k, 0
    for ch in word:
        if ch == 'L':
            d += 1
            if a[c] < 0:
                cz[-a[c] - 1] += 1
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            d -= 1
            if a[c] < 0:
                cz[-a[c] - 1] -= 1
        else:
            c2 = (c + 1) % n
            x, y = a[c], a[c2]
            if x < 0 and y < 0:
                return None
            q += 1
            nxt = [0] * k
            if x < 0:
                cz[-x - 1] += 1
                A[-x - 1] += 1
            elif y < 0:
                A[-y - 1] += 1
                nxt[-y - 1] = -1
            segs.append((d, cz))
            d, cz = 0, nxt
            a[c], a[c2] = y, x
    segs.append((d, cz))
    fin = a[c:] + a[:c]
    m = n - k
    if fin[:m] != list(range(1, m + 1)):
        return None
    B = q + sum(abs(s) for s, _ in segs)
    beta = [2 * A[i] + sum(abs(z[i]) for _, z in segs) for i in range(k)]
    return B, beta


def _budget(m, r):
    return m * (m + 1) // 2 + (r - 1) * (m - 2)


def _refine(v, origins):
    out, j = [], 0
    for x in v:
        if x:
            out.append(x)
        else:
            out.extend([0] * origins[j])
            j += 1
    return out


def _price_all_picks(v, word, origins):
    """Computes (B, {pick_tuple: beta_tuple}) for all stretched zero atom choices."""
    n = len(v)
    k = len(origins)
    tot_zeros = sum(origins)
    m = n - tot_zeros
    a, g = [], 0
    for x in v:
        if x:
            a.append(x)
        else:
            a.append(-1 - g)
            g += 1

    A = [0] * tot_zeros
    cz = [0] * tot_zeros
    segs, q, d, c = [], 0, 0, 0

    for ch in word:
        if ch == 'L':
            d += 1
            if a[c] < 0:
                cz[-1 - a[c]] += 1
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            d -= 1
            if a[c] < 0:
                cz[-1 - a[c]] -= 1
        else:
            c2 = (c + 1) % n
            x, y = a[c], a[c2]
            if x < 0 and y < 0:
                return None
            q += 1
            nxt = [0] * tot_zeros
            if x < 0:
                cz[-1 - x] += 1
                A[-1 - x] += 1
            elif y < 0:
                A[-1 - y] += 1
                nxt[-1 - y] = -1
            segs.append((d, cz))
            d, cz = 0, nxt
            a[c], a[c2] = y, x

    segs.append((d, cz))
    fin = a[c:] + a[:c]
    if fin[:m] != list(range(1, m + 1)):
        return None

    B = q + sum(abs(s) for s, _ in segs)
    all_betas = [2 * A[i] + sum(abs(z[i]) for _, z in segs) for i in range(tot_zeros)]
    return B, all_betas


def _sweep_words(v, deadline):
    n, m = len(v), max(v)
    r = n - m
    if r <= 4:
        perms = list(itertools.permutations(range(r)))
    else:
        perms = [[(s + i) % r for i in range(r)] for s in range(r)] + [
            [(s + r - 1 - i) % r for i in range(r)] for s in range(r)
        ]
    words = set()
    for t in range(n):
        if _time.process_time() > deadline:
            break
        for perm in perms:
            for rem in _lifts(v, t, perm, m, r):
                for c_start in (0, t) if t != 0 else (0,):
                    for mode in ('L', 'R', 'greedy', 'greedy_R', 'bounce_L', 'bounce_R'):
                        w = _sweep(v, rem, t, mode, c_start=c_start)
                        if w is not None:
                            w = _reduce(w)
                            if len(w) <= 4000:
                                words.add(w)
    return sorted(words, key=lambda w: (len(w), w))


def _pareto(priced):
    best = {}
    for w, B, beta in priced:
        key = (B,) + tuple(beta)
        if key not in best or (len(w), w) < (len(best[key]), best[key]):
            best[key] = w
    keys = sorted(best)
    keep = []
    for x in keys:
        if not any(all(p <= q for p, q in zip(y, x)) for y in keep):
            keep.append(x)
    return [(best[x], x[0], list(x[1:])) for x in keep]


def _simplex(A, b, c):
    rows, cols = len(A), len(c)
    T = []
    for i in range(rows):
        s = -1.0 if b[i] < 0 else 1.0
        T.append([s * x for x in A[i]] + [1.0 if r == i else 0.0 for r in range(rows)] + [s * b[i]])
    basis = list(range(cols, cols + rows))

    def pivot(r, j):
        p = T[r][j]
        inv = 1.0 / p
        T[r] = [x * inv for x in T[r]]
        for i in range(rows):
            if i != r:
                f = T[i][j]
                if abs(f) > 1e-15:
                    T[i] = [x - f * y for x, y in zip(T[i], T[r])]
        basis[r] = j

    def run(cost, allowed):
        for _ in range(2000):
            enter = None
            for j in allowed:
                if j in basis:
                    continue
                red = cost[j] - sum(cost[basis[i]] * T[i][j] for i in range(rows))
                if red < -EPS:
                    enter = j
                    break
            if enter is None:
                return True
            cand = [i for i in range(rows) if T[i][enter] > EPS]
            if not cand:
                return False
            r = min(cand, key=lambda i: (T[i][-1] / T[i][enter], basis[i]))
            pivot(r, enter)
        return False

    if not run([0.0] * cols + [1.0] * rows, range(cols + rows)):
        return None
    if sum(T[i][-1] for i in range(rows) if basis[i] >= cols) > 1e-7:
        return None
    for r in range(rows):
        if basis[r] >= cols:
            j = next((j for j in range(cols) if abs(T[r][j]) > EPS and j not in basis), None)
            if j is not None:
                pivot(r, j)
    if not run(list(c) + [0.0] * rows, range(cols)):
        return None
    x = [0.0] * cols
    for i, j in enumerate(basis):
        if j < cols:
            x[j] = T[i][-1]
    return x, sum(ci * xi for ci, xi in zip(c, x))


def _leaf_lp(cols, origins, lo, hi, s, m):
    k = len(lo)
    n = len(cols)
    bnd = [j for j in range(k) if hi[j] is not None]
    T = _budget(m, sum(lo))
    cost = [B + sum(b * (l - o) for b, l, o in zip(beta, lo, origins)) for _, B, beta in cols]
    A = []
    for j in range(k):
        A.append([beta[j] for _, _, beta in cols] + [-1.0 if bj == j else 0.0 for bj in bnd]
                 + [1.0 if i == j else 0.0 for i in range(k)])
    A.append([1.0] * n + [0.0] * (len(bnd) + k))
    c = cost + [hi[j] - lo[j] for j in bnd] + [0.0] * k
    out = _simplex(A, [float(s)] * k + [1.0], c)
    if out is None:
        return False, None
    x, val = out
    return val < T + 1 - 1e-6, x[:n]


def _leaf(cols, origins, weights, pick_indices=None):
    order = sorted(range(len(cols)), key=lambda i: (-weights[i], cols[i][1], i))
    words = [cols[i][0] for i in order if weights[i] > 1e-12]
    for i in order:
        if len(words) >= LEAF_WORDS:
            break
        if cols[i][0] not in words:
            words.append(cols[i][0])
    res = {'words': words[:LEAF_WORDS], 'origins': list(origins)}
    if pick_indices is not None and any(p != 0 for p in pick_indices):
        res['picks'] = list(pick_indices)
    return res


def _extract_picked_cols(parsed_words, origins, pick_indices):
    block_starts = []
    cur = 0
    for o in origins:
        block_starts.append(cur)
        cur += o
    global_picks = [block_starts[j] + pick_indices[j] for j in range(len(origins))]
    priced = []
    for w, B, all_betas in parsed_words:
        beta = [all_betas[gp] for gp in global_picks]
        priced.append((w, B, beta))
    return _pareto(priced)


def _get_parsed_words(v, origins, deadline, parsed_cache):
    key = tuple(origins)
    if key not in parsed_cache:
        ref = _refine(v, origins)
        pwords = []
        for w in _sweep_words(ref, deadline):
            res = _price_all_picks(ref, w, origins)
            if res is not None:
                pwords.append((w, res[0], res[1]))
        parsed_cache[key] = pwords
    return parsed_cache[key]


def _try_solve_leaf(parsed_words, origins, lo, hi, s, m):
    """Searches picks for the best passing LP mixture."""
    k = len(origins)
    best_picks = None
    best_cols = None
    best_w = None

    cands = []
    for j in range(k):
        cands.append(list(range(origins[j])))

    # Test default picks first
    default_picks = [0] * k
    dcols = _extract_picked_cols(parsed_words, origins, default_picks)
    if dcols:
        ok, w = _leaf_lp(dcols, origins, lo, hi, s, m)
        if ok:
            return True, dcols, default_picks, w

    # Try variations for blocks with origin > 1
    active_blocks = [j for j in range(k) if origins[j] > 1]
    for comb in itertools.product(*(cands[j] for j in active_blocks)):
        cur_picks = [0] * k
        for idx, j in enumerate(active_blocks):
            cur_picks[j] = comb[idx]
        if cur_picks == default_picks:
            continue
        cols = _extract_picked_cols(parsed_words, origins, cur_picks)
        if not cols:
            continue
        ok, w = _leaf_lp(cols, origins, lo, hi, s, m)
        if ok:
            return True, cols, cur_picks, w

    return False, None, None, None


def _staircase(v, m, k, axis, deadline, parsed_cache):
    s = m - 2
    leaves, l = [], 1
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        origins = [1] * k
        origins[axis] = min(l, MAX_ORIGIN)
        pwords = _get_parsed_words(v, origins, deadline, parsed_cache)
        if not pwords:
            return None
        lo = [1] * k
        lo[axis] = l

        ok, cols, picks, w = _try_solve_leaf(pwords, origins, lo, [None] * k, s, m)
        if ok:
            leaves.append((_leaf(cols, origins, w, picks), None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree

        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None

        lo_h, hi_h, best = l, MAX_CUT, None
        while lo_h <= hi_h:
            mid = (lo_h + hi_h) // 2
            hi = [None] * k
            hi[axis] = mid
            pass_mid, c_mid, p_mid, w_mid = _try_solve_leaf(pwords, origins, lo, hi, s, m)
            if pass_mid:
                best = (mid, c_mid, p_mid, w_mid)
                lo_h = mid + 1
            else:
                hi_h = mid - 1
        if best is None:
            return None
        h_val, best_cols, best_picks, best_w = best
        leaves.append((_leaf(best_cols, origins, best_w, best_picks), h_val))
        l = h_val + 1
    return None


def pool(v):
    r = len(v) - max(v)
    deadline = _time.process_time() + 1.5
    raw_words = _sweep_words(v, deadline)
    words = {}
    for w in raw_words:
        p = price(v, w)
        if p is not None:
            words[w] = p
    return words


def _root_certify(v):
    words = pool(v)
    if not words:
        return {'words': []}
    word_list = list(words.keys())
    m = max(v)
    k = sum(1 for x in v if x == 0)
    T = _budget(m, k)
    costs = [[words[w][0] - T] + [b - (m - 2) for b in words[w][1]] for w in word_list]
    n_words, dim = len(word_list), k + 1
    hull_indices = set()

    for d in range(dim):
        hull_indices.add(min(range(n_words), key=lambda i: (costs[i][d], max(costs[i]))))

    for j in range(1, dim):
        pts = sorted(range(n_words), key=lambda i: (costs[i][0], costs[i][j]))
        lower = []
        for p in pts:
            while len(lower) >= 2:
                p1, p2 = lower[-2], lower[-1]
                dx1, dy1 = costs[p2][0] - costs[p1][0], costs[p2][j] - costs[p1][j]
                dx2, dy2 = costs[p][0] - costs[p1][0], costs[p][j] - costs[p1][j]
                if dx1 * dy2 - dy1 * dx2 <= 0:
                    lower.pop()
                else:
                    break
            lower.append(p)
        for idx in lower:
            hull_indices.add(idx)

    for j in range(1, dim):
        for ratio in (0.1, 0.25, 0.5, 1.0, 2.0, 4.0, 10.0):
            hull_indices.add(min(range(n_words), key=lambda i: costs[i][0] + ratio * costs[i][j]))

    for alpha in (1.5, 3.0):
        for start_mode in ('min_max', 'min_b'):
            cur_idx = min(range(n_words), key=lambda i: (max(costs[i]), costs[i][0]) if start_mode == 'min_max' else (costs[i][0], max(costs[i])))
            cur_vec = list(costs[cur_idx])
            hull_indices.add(cur_idx)
            for it in range(1, 35):
                mx = max(cur_vec)
                exps = [math.exp(min(50.0, alpha * (val - mx))) for val in cur_vec]
                tot = sum(exps)
                weights = [e / tot for e in exps]
                best_i = min(range(n_words), key=lambda i: sum(weights[d] * costs[i][d] for d in range(dim)))
                hull_indices.add(best_i)
                gamma = 2.0 / (it + 2)
                for d in range(dim):
                    cur_vec[d] = (1.0 - gamma) * cur_vec[d] + gamma * costs[best_i][d]

    ordered = sorted(hull_indices, key=lambda i: (max(costs[i]), costs[i][0], sum(costs[i])))
    selected = list(ordered[:KEEP])
    if len(selected) < KEEP:
        for idx in sorted(range(n_words), key=lambda i: (max(costs[i]), costs[i][0])):
            if idx not in selected:
                selected.append(idx)
                if len(selected) >= KEEP:
                    break
    res = [word_list[i] for i in selected[:KEEP]]
    return {'words': res}


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
    m, k = max(v), sum(1 for x in v if x == 0)

    out = _root_certify(v)
    root = {'words': out['words'], 'origins': [1] * k}
    base = []
    for w in out['words']:
        p = price(v, w)
        if p is not None:
            base.append((w, p[0], p[1]))
    if base and _leaf_lp(base, [1] * k, [1] * k, [None] * k, m - 2, m)[0]:
        return {'tree': root}

    parsed_cache = {}
    unit_pwords = []
    for w, B, beta in base:
        unit_pwords.append((w, B, beta))
    # Also add remaining root pool words to unit_pwords for better resolution
    root_pool = pool(v)
    for w, (B, beta) in root_pool.items():
        unit_pwords.append((w, B, beta))
    parsed_cache[tuple([1] * k)] = unit_pwords

    unit_pareto = _pareto(unit_pwords)
    load = [min((beta[j] for _, _, beta in unit_pareto), default=0) for j in range(k)]
    axes = sorted(range(k), key=lambda j: (-load[j], j))

    for axis in axes:
        if _time.process_time() > deadline:
            break
        tree = _staircase(v, m, k, axis, deadline, parsed_cache)
        if tree is not None:
            return {'tree': tree}

    return {'tree': root}
