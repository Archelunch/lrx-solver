        ok_root, w_root = _leaf_lp(cols_unit, unit_origins, unit_origins, [None] * k, s, m)
        if ok_root:
            return {'tree': _leaf(cols_unit, unit_origins, w_root)}

    load = [min(beta[j] for _, _, beta in cols_unit) if cols_unit else 0 for j in range(k)]
    sorted_axes = sorted(range(k), key=lambda j: (-load[j], j))

    for max_origin_try in (MAX_ORIGIN, 3):
        for axis in sorted_axes:
