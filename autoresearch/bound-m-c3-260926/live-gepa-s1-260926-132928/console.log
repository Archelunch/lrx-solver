    while any(rem) and len(out) < limit:
        if mode.startswith('greedy'):
            dirs = (1, -1) if mode == 'greedy' else (-1, 1)
            for dist in range(n):
                found = False
                for sgn in dirs:
                    pos = (c + sgn * dist) % n
                    if must_cross(pos):
                        out.append(('L' if sgn == 1 else 'R') * dist)
                        c = pos
                        found = True
                        break
                if found:
                    break
            else:
                return None
            cross(c)
            continue
        elif mode.startswith('bounce'):
            if must_cross(c):
                cross(c)
                if not any(rem):
                    break
            step_ch = 'L' if bounce_dir == 1 else 'R'
            out.append(step_ch)
            c = (c + bounce_dir) % n
            bounce_steps += 1
            if bounce_steps >= n - 1:
                bounce_dir = -bounce_dir
                bounce_steps = 0
            continue
        if must_cross(c):
            cross(c)
            if not any(rem):
                break
        out.append(mode)
        c = (c + (1 if mode == 'L' else -1)) % n
    if any(rem):
        return None
    d = (t - c) % n
    out.append('L' * d if d <= n - d else 'R' * (n - d))
    return ''.join(out)


def price(v, word):
    n, k = len(v), sum(1 for x in v if x == 0)
    a, j = [], 0
    for x in v:
        if x:
            a.append(x)
        else:
            j += 1
            a.append(-j)
    segs, A, q, d, cz, c = [], [0] * k, 0, 0, [0] * k, 0
    for ch in word:
        if ch == 'L':
            d += 1
            if a[c] < 0:
                cz[-a[c] - 1] += 1
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            d -= 1
            if a[c] < 0:
                cz[-a[c] - 1] -= 1
        else:
            c2 = (c + 1) % n
            x, y = a[c], a[c2]
            if x < 0 and y < 0:
                return None
            q += 1
            nxt = [0] * k
            if x < 0:
                cz[-x - 1] += 1
                A[-x - 1] += 1
            elif y < 0:
                A[-y - 1] += 1
                nxt[-y - 1] = -1
            segs.append((d, cz))
            d, cz = 0, nxt
            a[c], a[c2] = y, x
    segs.append((d, cz))
    fin = a[c:] + a[:c]
    m = n - k
    if fin[:m] != list(range(1, m + 1)):
        return None
    B = q + sum(abs(s) for s, _ in segs)
    beta = [2 * A[i] + sum(abs(z[i]) for _, z in segs) for i in range(k)]
    return B, beta


def _budget(m, r):
    return m * (m + 1) // 2 + (r - 1) * (m - 2)


def _refine(v, origins):
    out, j = [], 0
    for x in v:
        if x:
            out.append(x)
        else:
            out.extend([0] * origins[j])
            j += 1
    return out


def _price_picks(v, word, picks):
    n = len(v)
    k = len(picks)
    blk = {p: j for j, p in enumerate(picks)}
    a, g = [], 0
    for x in v:
        if x:
            a.append(x)
        else:
            a.append(-1 - g)
            g += 1
    m = n - g
    A, q, d, cz, c = [0] * k, 0, 0, [0] * k, 0
    segs = []
    for ch in word:
        if ch == 'L':
            d += 1
            if a[c] < 0 and (-1 - a[c]) in blk:
                cz[blk[-1 - a[c]]] += 1
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            d -= 1
            if a[c] < 0 and (-1 - a[c]) in blk:
                cz[blk[-1 - a[c]]] -= 1
        else:
            c2 = (c + 1) % n
            x, y = a[c], a[c2]
            if x < 0 and y < 0:
                return None
            q += 1
            nxt = [0] * k
            if x < 0 and (-1 - x) in blk:
                cz[blk[-1 - x]] += 1
                A[blk[-1 - x]] += 1
            elif y < 0 and (-1 - y) in blk:
                A[blk[-1 - y]] += 1
                nxt[blk[-1 - y]] = -1
            segs.append((d, cz))
            d, cz = 0, nxt
            a[c], a[c2] = y, x
    segs.append((d, cz))
    fin = a[c:] + a[:c]
    if fin[:m] != list(range(1, m + 1)):
        return None
    B = q + sum(abs(s) for s, _ in segs)
    beta = [2 * A[i] + sum(abs(z[i]) for _, z in segs) for i in range(k)]
    return B, beta


def _sweep_words(v, deadline):
    n, m = len(v), max(v)
    r = n - m
    if r <= 4:
        perms = list(itertools.permutations(range(r)))
    else:
        perms = [[(s + i) % r for i in range(r)] for s in range(r)] + [
            [(s + r - 1 - i) % r for i in range(r)] for s in range(r)]
    words = set()
    for t in range(n):
        if _time.process_time() > deadline:
            break
        for perm in perms:
            for rem in _lifts(v, t, perm, m, r):
                for c_start in (0, t) if t != 0 else (0,):
                    for mode in ('L', 'R', 'greedy', 'greedy_R', 'bounce_L', 'bounce_R'):
                        w = _sweep(v, rem, t, mode, c_start=c_start)
                        if w is not None:
                            w = _reduce(w)
                            if len(w) <= 4000:
                                words.add(w)
    return sorted(words, key=lambda w: (len(w), w))


def _pareto(priced):
    best = {}
    for w, B, beta in priced:
        key = (B,) + tuple(beta)
        if key not in best or (len(w), w) < (len(best[key]), best[key]):
            best[key] = w
    keys = sorted(best)
    keep = []
    for x in keys:
        if not any(all(p <= q for p, q in zip(y, x)) for y in keep):
            keep.append(x)
    return [(best[x], x[0], list(x[1:])) for x in keep]


def _simplex(A, b, c):
    rows, cols = len(A), len(c)
    T = []
    for i in range(rows):
        s = -1.0 if b[i] < 0 else 1.0
        T.append([s * x for x in A[i]] + [1.0 if r == i else 0.0 for r in range(rows)] + [s * b[i]])
    basis = list(range(cols, cols + rows))

    def pivot(r, j):
        p = T[r][j]
        T[r] = [x / p for x in T[r]]
        for i in range(rows):
            if i != r and abs(T[i][j]) > 1e-15:
                f = T[i][j]
                T[i] = [x - f * y for x, y in zip(T[i], T[r])]
        basis[r] = j

    def run(cost, allowed):
        for _ in range(1200):
            enter = None
            for j in allowed:
                if j in basis:
                    continue
                if cost[j] - sum(cost[basis[i]] * T[i][j] for i in range(rows)) < -EPS:
                    enter = j
                    break
            if enter is None:
                return True
            cand = [i for i in range(rows) if T[i][enter] > EPS]
            if not cand:
                return False
            r = min(cand, key=lambda i: (T[i][-1] / T[i][enter], basis[i]))
            pivot(r, enter)
        return False

    if not run([0.0] * cols + [1.0] * rows, range(cols + rows)):
        return None
    if sum(T[i][-1] for i in range(rows) if basis[i] >= cols) > 1e-7:
        return None
    for r in range(rows):
        if basis[r] >= cols:
            j = next((j for j in range(cols) if abs(T[r][j]) > EPS and j not in basis), None)
            if j is not None:
                pivot(r, j)
    if not run(list(c) + [0.0] * rows, range(cols)):
        return None
    x = [0.0] * cols
    for i, j in enumerate(basis):
        if j < cols:
            x[j] = T[i][-1]
    return x, sum(ci * xi for ci, xi in zip(c, x))


def _leaf_lp(cols, origins, lo, hi, s, m):
    k = len(lo)
    n = len(cols)
    bnd = [j for j in range(k) if hi[j] is not None]
    T = _budget(m, sum(lo))
    cost = [B + sum(b * (l - o) for b, l, o in zip(beta, lo, origins)) for _, B, beta in cols]
    A = []
    for j in range(k):
        A.append([beta[j] for _, _, beta in cols] + [-1.0 if bj == j else 0.0 for bj in bnd]
                 + [1.0 if i == j else 0.0 for i in range(k)])
    A.append([1.0] * n + [0.0] * (len(bnd) + k))
    c = cost + [hi[j] - lo[j] for j in bnd] + [0.0] * k
    out = _simplex(A, [float(s)] * k + [1.0], c)
    if out is None:
        return False, None
    x, val = out
    return val < T + 1 - 1e-6, x[:n]


def _make_leaf(cols, origins, picks_in_block, weights):
    order = sorted(range(len(cols)), key=lambda i: (-weights[i], cols[i][1], i))
    words = [cols[i][0] for i in order if weights[i] > 1e-12]
    for i in order:
        if len(words) >= LEAF_WORDS:
            break
        if cols[i][0] not in words:
            words.append(cols[i][0])
    res = {'words': words[:LEAF_WORDS], 'origins': list(origins)}
    if any(p != 0 for p in picks_in_block):
        res['picks'] = list(picks_in_block)
    return res


def _columns_opt(v, origins, deadline, raw_words_cache, priced_cache):
    orig_key = tuple(origins)
    if orig_key not in raw_words_cache:
        ref = _refine(v, origins)
        raw_words_cache[orig_key] = (ref, _sweep_words(ref, deadline))
    ref, w_list = raw_words_cache[orig_key]

    k = len(origins)
    best_res = None
    best_min_beta = float('inf')

    # Try standard pick configurations: 0 (first atom), -1 (last atom), and middle atom
    cand_picks_list = []
    base_picks = [0] * k
    cand_picks_list.append(base_picks)

    # For any non-trivial block, also test last atom
    for ax in range(k):
        if origins[ax] > 1:
            alt1 = list(base_picks)
            alt1[ax] = origins[ax] - 1
            cand_picks_list.append(alt1)
            if origins[ax] > 2:
                alt2 = list(base_picks)
                alt2[ax] = origins[ax] // 2
                cand_picks_list.append(alt2)

    for p_in_block in cand_picks_list:
        cache_key = (orig_key, tuple(p_in_block))
        if cache_key in priced_cache:
            p_cols = priced_cache[cache_key]
        else:
            global_picks = []
            cur_atom = 0
            for ax, o in enumerate(origins):
                global_picks.append(cur_atom + p_in_block[ax])
                cur_atom += o
            priced = []
            for w in w_list:
                p = _price_picks(ref, w, global_picks)
                if p is not None:
                    priced.append((w, p[0], p[1]))
            p_cols = _pareto(priced)
            priced_cache[cache_key] = p_cols

        if p_cols:
            m_beta = min(min(beta) for _, _, beta in p_cols)
            if m_beta < best_min_beta:
                best_min_beta = m_beta
                best_res = (p_cols, p_in_block)

    return best_res if best_res is not None else ([], [0] * k)


def _staircase(v, m, k, axis, deadline, raw_words_cache, priced_cache):
    s = m - 2
    leaves, l = [], 1
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        origins = [1] * k
        origins[axis] = min(l, MAX_ORIGIN)
        cols, picks_in_b = _columns_opt(v, origins, deadline, raw_words_cache, priced_cache)
        if not cols:
            return None
        lo = [1] * k
        lo[axis] = l
        ok, w = _leaf_lp(cols, origins, lo, [None] * k, s, m)
        if ok:
            leaves.append((_make_leaf(cols, origins, picks_in_b, w), None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree
        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None
        lo_h, hi_h, best, best_picks = l, MAX_CUT, None, None
        while lo_h <= hi_h:
            mid = (lo_h + hi_h) // 2
            hi = [None] * k
            hi[axis] = mid
            ok, w = _leaf_lp(cols, origins, lo, hi, s, m)
            if ok:
                best, best_picks, lo_h = (mid, w), picks_in_b, mid + 1
            else:
                hi_h = mid - 1
        if best is None:
            return None
        leaves.append((_make_leaf(cols, origins, best_picks, best[1]), best[0]))
        l = best[0] + 1
    return None


def _two_axis_staircase(v, m, k, ax1, ax2, deadline, raw_words_cache, priced_cache):
    """Splits ax1 at 1..cut, and on the unbounded piece splits ax2."""
    s = m - 2
    origins = [1] * k
    cols, picks_in_b = _columns_opt(v, origins, deadline, raw_words_cache, priced_cache)
    if not cols:
        return None
    # Check bounded ax1 leaf [1, 1] or [1, 2]
    for cut in (1, 2):
        lo1 = [1] * k
        hi1 = [None] * k
        hi1[ax1] = cut
        ok1, w1 = _leaf_lp(cols, origins, lo1, hi1, s, m)
        if ok1:
            leaf1 = _make_leaf(cols, origins, picks_in_b, w1)
            # Try staircase on ax2 for ge branch
            # Under ge branch, lo for ax1 is cut + 1
            sub_deadline = deadline
            # test bounded/unbounded on ax2
            orig2 = [1] * k
            orig2[ax1] = min(cut + 1, MAX_ORIGIN)
            orig2[ax2] = min(2, MAX_ORIGIN)
            cols2, picks2 = _columns_opt(v, orig2, sub_deadline, raw_words_cache, priced_cache)
            if cols2:
                lo2 = [1] * k
                lo2[ax1] = cut + 1
                ok2, w2 = _leaf_lp(cols2, orig2, lo2, [None] * k, s, m)
                if ok2:
                    leaf2 = _make_leaf(cols2, orig2, picks2, w2)
                    return {'j': ax1, 't': cut, 'le': leaf1, 'ge': leaf2}
    return None


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
    m = max(v)
    k = sum(1 for x in v if x == 0)
    T = _budget(m, k)

    raw_words_cache = {}
    priced_cache = {}

    unit_orig = tuple([1] * k)
    unit_cols, _ = _columns_opt(v, [1] * k, deadline, raw_words_cache, priced_cache)
    if not unit_cols:
        return {'words': []}

    # First check if unit origin unbounded LP closes directly
    ok, w = _leaf_lp(unit_cols, [1] * k, [1] * k, [None] * k, m - 2, m)
    if ok:
        leaf = _make_leaf(unit_cols, [1] * k, [0] * k, w)
        return {'tree': leaf, 'note': 'unit root certified'}

    # Collect min beta load per axis to prioritize most constrained axis
    load = [min(beta[j] for _, _, beta in unit_cols) for j in range(k)]
    sorted_axes = sorted(range(k), key=lambda j: (-load[j], j))

    # Single-axis staircase search
    for axis in sorted_axes:
        if _time.process_time() > deadline:
            break
        tree = _staircase(v, m, k, axis, deadline, raw_words_cache, priced_cache)
        if tree is not None:
            return {'tree': tree, 'note': 'refined-origin staircase on axis %d' % axis}

    # Two-axis split fallback if k >= 2 and time remains
    if k >= 2 and len(sorted_axes) >= 2 and _time.process_time() < deadline:
        ax1, ax2 = sorted_axes[0], sorted_axes[1]
        tree2 = _two_axis_staircase(v, m, k, ax1, ax2, deadline, raw_words_cache, priced_cache)
        if tree2 is not None:
            return {'tree': tree2, 'note': 'two-axis split (%d, %d)' % (ax1, ax2)}

    # Fallback root leaf from unit_cols with minimax Frank-Wolfe selection
    costs = [[B - T] + [b - (m - 2) for b in beta] for _, B, beta in unit_cols]
    dim = k + 1
    hull_indices = set()
    for d in range(dim):
        hull_indices.add(min(range(len(unit_cols)), key=lambda i: (costs[i][d], max(costs[i]))))
    for j in range(1, dim):
        for ratio in (0.2, 0.5, 1.0, 2.0, 5.0):
            hull_indices.add(min(range(len(unit_cols)), key=lambda i: costs[i][0] + ratio * costs[i][j]))
    ordered = sorted(hull_indices, key=lambda i: (max(costs[i]), costs[i][0]))
    selected = [unit_cols[i][0] for i in ordered[:KEEP]]
    return {'tree': {'words': selected, 'origins': [1] * k}, 'note': 'fallback root leaf'}
