            q += 1
            nxt = [0] * g
            if x < 0:
                cz[-1 - x] += 1
                A[-1 - x] += 1
            elif y < 0:
                A[-1 - y] += 1
                nxt[-1 - y] = -1
            segs.append((d, cz))
            d, cz = 0, nxt
            a[c], a[c2] = y, x

    segs.append((d, cz))
    fin = a[c:] + a[:c]
    if fin[:m] != list(range(1, m + 1)):
        return None

    B = q + sum(abs(s) for s, _ in segs)
    atom_beta = [2 * A[i] + sum(abs(z[i]) for _, z in segs) for i in range(g)]

    # Per block j, list of betas for each internal zero atom
    beta_by_block = []
