                break
            tree = _staircase(v, m, k, axis, deadline, cache, max_o=max_origin_try)
            if tree is not None:
                return {'tree': tree}

    fallback_words = [w for w, _, _ in cols_unit[:KEEP]] if cols_unit else []
    return {'tree': {'words': fallback_words, 'origins': unit_origins}}
