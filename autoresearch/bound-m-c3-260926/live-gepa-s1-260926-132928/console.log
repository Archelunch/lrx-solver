                break
            if best_cols is None:
                best_cols, best_pick = cols, p_blk

        if best_cols is None:
            return None

        origins = [1] * k
        origins[axis] = target_o
        lo = [1] * k
        lo[axis] = l

        if best_ok:
            leaves.append((_leaf(best_cols, origins, best_w, best_pick), None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree

        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None

        lo_h, hi_h, best_pass = l, MAX_CUT, None
        while lo_h <= hi_h:
            mid = (lo_h + hi_h) // 2
            hi = [None] * k
            hi[axis] = mid
            ok, w = _leaf_lp(best_cols, origins, lo, hi, s, m)
            if ok:
                best_pass, lo_h = (mid, w), mid + 1
            else:
                hi_h = mid - 1

        if best_pass is None:
            return None
        leaves.append((_leaf(best_cols, origins, best_pass[1], best_pick), best_pass[0]))
        l = best_pass[0] + 1
    return None


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
