    return False, best_res[0] if best_res else None, [0] * k, None


def _staircase(v, m, k, axis, deadline, parsed_words_cache):
    s = m - 2
    leaves, l = [], 1
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
