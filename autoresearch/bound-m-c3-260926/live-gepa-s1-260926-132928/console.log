            keep.append(x)
    return [p_opt] + [0] * (k - 1), [(best_map[x], x[0], list(x[1:])) for x in keep]


def _columns_pick(v, origins, deadline, cache):
    key = tuple(origins)
    if key not in cache:
        ref = _refine(v, origins)
        k = len(origins)
        offsets = [sum(origins[:j]) for j in range(k)]
        raw = _sweep_words(ref, deadline, quick=(sum(origins) > k + 2))
        
        # Test candidate picks for axis where origin > 1
        active_axes = [j for j in range(k) if origins[j] > 1]
        best_picks = list(offsets)
        best_priced = []
        min_load = 1e9

        cand_picks_list = [list(offsets)]
        if active_axes:
            ax = active_axes[0]
            for p in range(origins[ax]):
                cp = list(offsets)
                cp[ax] += p
                cand_picks_list.append(cp)

        for cp in cand_picks_list:
            priced = []
            for w in raw:
                pr = _price_picks(ref, w, cp)
                if pr is not None:
                    priced.append((w, pr[0], pr[1]))
            if priced:
                load = sum(b[active_axes[0]] for _, _, b in priced) if active_axes else sum(pr[1][0] for pr in priced)
                if load < min_load:
                    min_load = load
                    best_picks = cp
                    best_priced = priced

        best_map = {}
        for w, B, beta in best_priced:
            mkey = (B,) + tuple(beta)
            if mkey not in best_map or (len(w), w) < (len(best_map[mkey]), best_map[mkey]):
                best_map[mkey] = w
        keys = sorted(best_map)
        keep = []
        for x in keys:
            if not any(all(p_ <= q_ for p_, q_ in zip(y, x)) for y in keep):
                keep.append(x)
        rel_picks = [best_picks[j] - offsets[j] for j in range(k)]
        cache[key] = (rel_picks, [(best_map[x], x[0], list(x[1:])) for x in keep])
    return cache[key]


def _build_staircase(v, m, k, axis, deadline, cache):
    s = m - 2
    leaves, l = [], 1
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        origins = [1] * k
        origins[axis] = min(l, MAX_ORIGIN)
        picks, cols = _columns_pick(v, origins, deadline, cache)
        if not cols:
            return None
        lo = [1] * k
        lo[axis] = l
        ok, w = _leaf_lp(cols, origins, lo, [None] * k, s, m)
        if ok:
            leaves.append((_leaf(cols, origins, w, picks), None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree
        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None
        lo_h, hi_h, best = l, MAX_CUT, None
        while lo_h <= hi_h:
            mid = (lo_h + hi_h) // 2
            hi = [None] * k
            hi[axis] = mid
            ok, w = _leaf_lp(cols, origins, lo, hi, s, m)
            if ok:
                best, lo_h = (mid, w), mid + 1
            else:
                hi_h = mid - 1
        if best is None:
            return None
        leaves.append((_leaf(cols, origins, best[1], picks), best[0]))
        l = best[0] + 1
    return None


def _certify_root(v):
    raw = _sweep_words(v, _time.process_time() + 1.2)
    priced = {}
    for w in raw:
        p = price(v, w)
        if p is not None:
            priced[w] = p
    if not priced:
        return {'words': []}

    word_list = list(priced.keys())
    m = max(v)
    k = sum(1 for x in v if x == 0)
    T = _budget(m, k)
    costs = [[priced[w][0] - T] + [b - (m - 2) for b in priced[w][1]] for w in word_list]
    n_words = len(word_list)
    dim = k + 1

    hull = set()
    for d in range(dim):
        hull.add(min(range(n_words), key=lambda i: (costs[i][d], max(costs[i]))))

    for j in range(1, dim):
        pts = sorted(range(n_words), key=lambda i: (costs[i][0], costs[i][j]))
        lower = []
        for p in pts:
            while len(lower) >= 2:
                p1, p2 = lower[-2], lower[-1]
                dx1, dy1 = costs[p2][0] - costs[p1][0], costs[p2][j] - costs[p1][j]
                dx2, dy2 = costs[p][0] - costs[p1][0], costs[p][j] - costs[p1][j]
                if dx1 * dy2 - dy1 * dx2 <= 0:
                    lower.pop()
                else:
                    break
            lower.append(p)
        for idx in lower:
            hull.add(idx)

    for j in range(1, dim):
        for ratio in (0.2, 0.5, 1.0, 2.0, 5.0):
            hull.add(min(range(n_words), key=lambda i: costs[i][0] + ratio * costs[i][j]))

    for alpha in (1.5, 3.0):
        for start_mode in ('min_max', 'min_b'):
            cur_idx = min(range(n_words), key=lambda i: (max(costs[i]), costs[i][0]) if start_mode == 'min_max' else (costs[i][0], max(costs[i])))
            cur_vec = list(costs[cur_idx])
            hull.add(cur_idx)
            for it in range(1, 35):
                mx = max(cur_vec)
                exps = [math.exp(min(50.0, alpha * (val - mx))) for val in cur_vec]
                tot = sum(exps)
                weights = [e / tot for e in exps]
                best_i = min(range(n_words), key=lambda i: sum(weights[d] * costs[i][d] for d in range(dim)))
                hull.add(best_i)
                gamma = 2.0 / (it + 2)
                for d in range(dim):
                    cur_vec[d] = (1.0 - gamma) * cur_vec[d] + gamma * costs[best_i][d]

    ordered = sorted(hull, key=lambda i: (max(costs[i]), costs[i][0], sum(costs[i])))
    selected = list(ordered[:KEEP])
    if len(selected) < KEEP:
        for idx in sorted(range(n_words), key=lambda i: (max(costs[i]), costs[i][0])):
            if idx not in selected:
                selected.append(idx)
                if len(selected) >= KEEP:
                    break
    return {'words': [word_list[i] for i in selected[:KEEP]], 'all_priced': priced}


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
    m, k = max(v), sum(1 for x in v if x == 0)

    root_res = _certify_root(v)
    root_words = root_res.get('words', [])
    root = {'words': root_words, 'origins': [1] * k}
    all_priced = root_res.get('all_priced', {})

    base = []
    for w in root_words:
        if w in all_priced:
            base.append((w, all_priced[w][0], all_priced[w][1]))
        else:
            p = price(v, w)
            if p is not None:
                base.append((w, p[0], p[1]))

    if base and _leaf_lp(base, [1] * k, [1] * k, [None] * k, m - 2, m)[0]:
        return {'tree': root}

    cache = {}
    unit_priced = [(w, cost[0], cost[1]) for w, cost in all_priced.items()]
    best_map = {}
    for w, B, beta in unit_priced:
        key = (B,) + tuple(beta)
        if key not in best_map or (len(w), w) < (len(best_map[key]), best_map[key]):
            best_map[key] = w
    keys = sorted(best_map)
    keep = []
    for x in keys:
        if not any(all(p_ <= q_ for p_, q_ in zip(y, x)) for y in keep):
            keep.append(x)
    unit_cols = [(best_map[x], x[0], list(x[1:])) for x in keep]
    cache[tuple([1] * k)] = ([0] * k, unit_cols)

    # Prioritize split axis by worst slope excess
    loads = [min((beta[j] for _, _, beta in unit_cols), default=0) for j in range(k)]
    axes = sorted(range(k), key=lambda j: (-loads[j], j))

    for axis in axes:
        if _time.process_time() > deadline:
            break
        tree = _build_staircase(v, m, k, axis, deadline, cache)
        if tree is not None:
            return {'tree': tree}

    return {'tree': root}
