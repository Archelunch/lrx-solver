    return raw_cache[key]


def _columns_with_picks(v, origins, picks, deadline, raw_cache, col_cache):
    col_key = (tuple(origins), tuple(picks))
    if col_key not in col_cache:
        atom_list = _atom_data(v, origins, deadline, raw_cache)
        priced = []
        for w, B, b_all in atom_list:
            beta = [b_all[p] for p in picks]
            priced.append((w, B, beta))
        col_cache[col_key] = _pareto(priced)
    return col_cache[col_key]


def _best_picks_and_cols(v, origins, lo, hi, s, m, deadline, raw_cache, col_cache):
    k = len(origins)
