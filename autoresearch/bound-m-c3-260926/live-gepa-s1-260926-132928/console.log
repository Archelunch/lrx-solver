def _pareto(priced):
    best = {}
    for w, B, beta in priced:
        key = (B,) + tuple(beta)
        if key not in best or len(w) < len(best[key]):
            best[key] = w
    keys = sorted(best)
    keep = []
    for x in keys:
        if not any(all(p <= q for p, q in zip(y, x)) for y in keep):
            keep.append(x)
