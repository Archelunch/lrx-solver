    blk_offsets = []
    cur = 0
    for o in origins:
        blk_offsets.append(cur)
        cur += o
    global_picks = [blk_offsets[j] + picks[j] for j in range(len(origins))]

    priced = []
    for w, B, beta_atoms in parsed:
        beta = [beta_atoms[gp] for gp in global_picks]
        priced.append((w, B, beta))
    return _pareto(priced)


def _find_best_leaf(v, m, k, origins, lo, hi, s, deadline, parsed_words_cache, split_axis):
    """Tests local picks on origins[split_axis] to find one that satisfies the LP."""
    num_picks = origins[split_axis]
    pick_candidates = [0, num_picks - 1, num_picks // 2] if num_picks > 1 else [0]
    seen = set()
    best_res = None
