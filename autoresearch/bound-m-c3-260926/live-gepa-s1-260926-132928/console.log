    return sorted(words, key=lambda w: (len(w), w))


def _pareto(priced):
    best = {}
    for w, B, beta in priced:
        key = (B,) + tuple(beta)
        if key not in best or (len(w), w) < (len(best[key]), best[key]):
            best[key] = w
    keys = sorted(best)
    keep = []
    for x in keys:
        if not any(all(p <= q for p, q in zip(y, x)) for y in keep):
            keep.append(x)
    return [(best[x], x[0], list(x[1:])) for x in keep]


def _simplex(A, b, c):
    rows, cols = len(A), len(c)
    T = []
    for i in range(rows):
        s = -1.0 if b[i] < 0 else 1.0
        T.append([s * x for x in A[i]] + [1.0 if r == i else 0.0 for r in range(rows)] + [s * b[i]])
    basis = list(range(cols, cols + rows))

    def pivot(r, j):
        p = T[r][j]
        T[r] = [x / p for x in T[r]]
        for i in range(rows):
            if i != r and abs(T[i][j]) > 1e-15:
                f = T[i][j]
                T[i] = [x - f * y for x, y in zip(T[i], T[r])]
        basis[r] = j

    def run(cost, allowed):
        for _ in range(2500):
            enter = None
            for j in allowed:
                if j in basis:
                    continue
                if cost[j] - sum(cost[basis[i]] * T[i][j] for i in range(rows)) < -EPS:
                    enter = j
                    break
            if enter is None:
                return True
            cand = [i for i in range(rows) if T[i][enter] > EPS]
            if not cand:
                return False
            r = min(cand, key=lambda i: (T[i][-1] / T[i][enter], basis[i]))
            pivot(r, enter)
        return False

    if not run([0.0] * cols + [1.0] * rows, range(cols + rows)):
        return None
    if sum(T[i][-1] for i in range(rows) if basis[i] >= cols) > 1e-7:
        return None
    for r in range(rows):
        if basis[r] >= cols:
            j = next((j for j in range(cols) if abs(T[r][j]) > EPS and j not in basis), None)
            if j is not None:
                pivot(r, j)
    if not run(list(c) + [0.0] * rows, range(cols)):
        return None
    x = [0.0] * cols
    for i, j in enumerate(basis):
        if j < cols:
            x[j] = T[i][-1]
    return x, sum(ci * xi for ci, xi in zip(c, x))


def _leaf_lp(cols, origins, lo, hi, s, m):
    k = len(lo)
    n = len(cols)
    bnd = [j for j in range(k) if hi[j] is not None]
    T = _budget(m, sum(lo))
    cost = [B + sum(b * (l - o) for b, l, o in zip(beta, lo, origins)) for _, B, beta in cols]
    A = []
    for j in range(k):
        A.append([beta[j] for _, _, beta in cols] + [-1.0 if bj == j else 0.0 for bj in bnd]
                 + [1.0 if i == j else 0.0 for i in range(k)])
    A.append([1.0] * n + [0.0] * (len(bnd) + k))
    c = cost + [hi[j] - lo[j] for j in bnd] + [0.0] * k
    out = _simplex(A, [float(s)] * k + [1.0], c)
    if out is None:
        return False, None
    x, val = out
    return val < T + 1 - 1e-6, x[:n]


def _make_leaf(cols, origins, picks, weights):
    order = sorted(range(len(cols)), key=lambda i: (-weights[i], cols[i][1], i))
    words = [cols[i][0] for i in order if weights[i] > 1e-12]
    for i in order:
        if len(words) >= LEAF_WORDS:
            break
        if cols[i][0] not in words:
            words.append(cols[i][0])
    res = {'words': words[:LEAF_WORDS], 'origins': list(origins)}
    if picks and any(p != 0 for p in picks):
        # convert local pick index to global zero atom index
        base_offsets = [sum(origins[:j]) for j in range(len(origins))]
        res['picks'] = [base_offsets[j] + picks[j] for j in range(len(origins))]
    return res


def _get_sweep_words_cached(v, origins, deadline, raw_cache):
    key = tuple(origins)
    if key not in raw_cache:
        ref = _refine(v, origins)
        raw_cache[key] = (ref, _sweep_words(ref, deadline))
    return raw_cache[key]


def _get_columns_with_picks(v, origins, picks_local, deadline, raw_cache, col_cache):
    key = (tuple(origins), tuple(picks_local))
    if key not in col_cache:
        ref, sw = _get_sweep_words_cached(v, origins, deadline, raw_cache)
        base_offsets = [sum(origins[:j]) for j in range(len(origins))]
        global_picks = [base_offsets[j] + picks_local[j] for j in range(len(origins))]
        priced = []
        for w in sw:
            p = _price_picks(ref, w, global_picks)
            if p is not None:
                priced.append((w, p[0], p[1]))
        col_cache[key] = _pareto(priced)
    return col_cache[key]


def _select_c2_words(v, words):
    word_list = list(words.keys())
    m = max(v)
    k = sum(1 for x in v if x == 0)
    T = m * (m + 1) // 2 + (k - 1) * (m - 2)

    costs = []
    for w in word_list:
        B, beta = words[w]
        costs.append([B - T] + [b - (m - 2) for b in beta])

    n_words = len(word_list)
    dim = k + 1
    hull_indices = set()

    for d in range(dim):
        hull_indices.add(min(range(n_words), key=lambda i: (costs[i][d], max(costs[i]))))

    for j in range(1, dim):
        pts = sorted(range(n_words), key=lambda i: (costs[i][0], costs[i][j]))
        lower = []
        for p in pts:
            while len(lower) >= 2:
                p1, p2 = lower[-2], lower[-1]
                dx1, dy1 = costs[p2][0] - costs[p1][0], costs[p2][j] - costs[p1][j]
                dx2, dy2 = costs[p][0] - costs[p1][0], costs[p][j] - costs[p1][j]
                if dx1 * dy2 - dy1 * dx2 <= 0:
                    lower.pop()
                else:
                    break
            lower.append(p)
        for idx in lower:
            hull_indices.add(idx)

    for j in range(1, dim):
        for ratio in (0.1, 0.25, 0.5, 1.0, 2.0, 4.0, 10.0):
            hull_indices.add(min(range(n_words), key=lambda i: costs[i][0] + ratio * costs[i][j]))

    for alpha in (1.5, 3.0):
        for start_mode in ('min_max', 'min_b'):
            cur_idx = min(range(n_words), key=lambda i: (max(costs[i]), costs[i][0]) if start_mode == 'min_max'
                          else (costs[i][0], max(costs[i])))
            cur_vec = list(costs[cur_idx])
            hull_indices.add(cur_idx)
            for it in range(1, 40):
                mx = max(cur_vec)
                exps = [math.exp(min(50.0, alpha * (val - mx))) for val in cur_vec]
                tot = sum(exps)
                weights = [e / tot for e in exps]
                best_i = min(range(n_words), key=lambda i: sum(weights[d] * costs[i][d] for d in range(dim)))
                hull_indices.add(best_i)
                gamma = 2.0 / (it + 2)
                for d in range(dim):
                    cur_vec[d] = (1.0 - gamma) * cur_vec[d] + gamma * costs[best_i][d]

    ordered = sorted(hull_indices, key=lambda i: (max(costs[i]), costs[i][0], sum(costs[i])))
    selected_indices = list(ordered[:KEEP])
    if len(selected_indices) < KEEP:
        by_max = sorted(range(n_words), key=lambda i: (max(costs[i]), costs[i][0]))
        for idx in by_max:
            if idx not in selected_indices:
                selected_indices.append(idx)
                if len(selected_indices) >= KEEP:
                    break

    return [word_list[i] for i in selected_indices[:KEEP]]


def _try_solve_leaf(v, k, lo, hi, axis, s, m, deadline, raw_cache, col_cache):
    """Attempt to solve box [lo, hi] trying varying origins and picks on the active axis."""
    l = lo[axis]
    target_origins = [min(l, 1)]
    for o_cand in (min(l, 2), min(l, 3), min(l, 4), min(l, MAX_ORIGIN)):
        if o_cand not in target_origins:
            target_origins.append(o_cand)
    target_origins.reverse()

    for o_val in target_origins:
        origins = [1] * k
        origins[axis] = o_val
        # Try pick at 0, middle, and end of the block
        picks_cand = [0]
        if o_val > 1:
            if o_val - 1 not in picks_cand:
                picks_cand.append(o_val - 1)
            mid = o_val // 2
            if mid not in picks_cand:
                picks_cand.append(mid)

        for p_val in picks_cand:
            if _time.process_time() > deadline:
                return None
            picks_local = [0] * k
            picks_local[axis] = p_val
            cols = _get_columns_with_picks(v, origins, picks_local, deadline, raw_cache, col_cache)
            if not cols:
                continue
            ok, w = _leaf_lp(cols, origins, lo, hi, s, m)
            if ok:
                return cols, origins, picks_local, w
    return None


def _staircase(v, m, k, axis, deadline, raw_cache, col_cache):
    s = m - 2
    leaves, l = [], 1
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        lo = [1] * k
        lo[axis] = l
        hi_inf = [None] * k
        res = _try_solve_leaf(v, k, lo, hi_inf, axis, s, m, deadline, raw_cache, col_cache)
        if res is not None:
            cols, origins, picks_local, w = res
            leaves.append((_make_leaf(cols, origins, picks_local, w), None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree

        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None

        lo_h, hi_h, best = l, MAX_CUT, None
        while lo_h <= hi_h and _time.process_time() < deadline:
            mid = (lo_h + hi_h) // 2
            hi = [None] * k
            hi[axis] = mid
            res = _try_solve_leaf(v, k, lo, hi, axis, s, m, deadline, raw_cache, col_cache)
            if res is not None:
                best = (mid, res)
                lo_h = mid + 1
            else:
                hi_h = mid - 1
        if best is None:
            return None
        h_cut, (cols, origins, picks_local, w) = best
        leaves.append((_make_leaf(cols, origins, picks_local, w), h_cut))
        l = h_cut + 1
    return None


def _tree_2axes(v, m, k, ax1, ax2, deadline, raw_cache, col_cache):
    """Splits ax1 <= 2 vs ax1 >= 3, then attempts staircase on ax2 for each branch."""
    s = m - 2
    for t_cut in (2, 3, 1):
        if _time.process_time() > deadline:
            break
        # Left branch: u[ax1] in [1, t_cut]
        # Check if unbounded leaf on ax2 passes for this branch
        lo_l = [1] * k
        hi_l = [None] * k
        hi_l[ax1] = t_cut
        res_l = _try_solve_leaf(v, k, lo_l, hi_l, ax2, s, m, deadline, raw_cache, col_cache)
        if res_l is None:
            continue
        # Right branch: u[ax1] in [t_cut+1, inf)
        lo_r = [1] * k
        lo_r[ax1] = t_cut + 1
        hi_r = [None] * k
        res_r = _try_solve_leaf(v, k, lo_r, hi_r, ax2, s, m, deadline, raw_cache, col_cache)
        if res_r is None:
            continue

        leaf_l = _make_leaf(res_l[0], res_l[1], res_l[2], res_l[3])
        leaf_r = _make_leaf(res_r[0], res_r[1], res_r[2], res_r[3])
        return {'j': ax1, 't': t_cut, 'le': leaf_l, 'ge': leaf_r}
    return None


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
    m, k = max(v), sum(1 for x in v if x == 0)

    raw_cache = {}
    col_cache = {}

    # Pool on unit base
    ref1, sw1 = _get_sweep_words_cached(v, [1] * k, deadline, raw_cache)
    unit_words = {}
    for w in sw1:
        p = price(v, w)
        if p is not None:
            unit_words[w] = p

    root_words = _select_c2_words(v, unit_words) if unit_words else []
    root = {'words': root_words, 'origins': [1] * k}

    base = [(w, unit_words[w][0], unit_words[w][1]) for w in root_words if w in unit_words]
    if base and _leaf_lp(base, [1] * k, [1] * k, [None] * k, m - 2, m)[0]:
        return {'tree': root, 'note': 'root certified'}

    unit_pareto = _pareto([(w, p[0], p[1]) for w, p in unit_words.items()])
    col_cache[((1,) * k, (0,) * k)] = unit_pareto

    # Rank axes by difficulty
    load = [min(beta[j] for _, _, beta in unit_pareto) if unit_pareto else 0 for j in range(k)]
    sorted_axes = sorted(range(k), key=lambda j: (-load[j], j))

    # Single-axis staircases
    for axis in sorted_axes:
        if _time.process_time() > deadline:
            break
        tree = _staircase(v, m, k, axis, deadline, raw_cache, col_cache)
        if tree is not None:
            return {'tree': tree, 'note': 'refined-origin staircase on axis %d' % axis}

    # Two-axis split fallback
    if k >= 2 and _time.process_time() < deadline:
        ax1, ax2 = sorted_axes[0], sorted_axes[1]
        tree2 = _tree_2axes(v, m, k, ax1, ax2, deadline, raw_cache, col_cache)
        if tree2 is not None:
            return {'tree': tree2, 'note': '2-axis split on axes %d, %d' % (ax1, ax2)}
        tree2_rev = _tree_2axes(v, m, k, ax2, ax1, deadline, raw_cache, col_cache)
        if tree2_rev is not None:
            return {'tree': tree2_rev, 'note': '2-axis split on axes %d, %d' % (ax2, ax1)}

    return {'tree': root, 'note': 'no staircase within budget'}
