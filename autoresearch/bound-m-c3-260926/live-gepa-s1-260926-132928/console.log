    keep = []
    for x in keys:
        if not any(all(p <= q for p, q in zip(y, x)) for y in keep):
            keep.append(x)
    return [(best[x], x[0], list(x[1:])) for x in keep]


_SWEEP_CACHE = {}


def _get_base_sweeps(v_ref, deadline):
    key = tuple(v_ref)
    if key not in _SWEEP_CACHE:
        _SWEEP_CACHE[key] = _sweep_words(v_ref, deadline)
    return _SWEEP_CACHE[key]


def _get_leaf_candidate(v, origins, deadline, cache, lo, hi, s, m):
    """Finds best (cols, picks, weights) passing the LP on [lo, hi], optimizing picks."""
    k = len(origins)
    ref = _refine(v, origins)
    sweeps = _get_base_sweeps(ref, deadline)
    offsets = []
    cur = 0
    for o in origins:
        offsets.append(cur)
        cur += o

    candidate_picks = []
    # Try pick 0, pick -1 (last), and middle pick for each refined block
    options_per_block = []
    for j in range(k):
        opts = [0]
        if origins[j] > 1:
            opts.append(origins[j] - 1)
        if origins[j] > 2:
            opts.append(origins[j] // 2)
        options_per_block.append(sorted(set(opts)))

    # Generate pick combinations (limited to avoid combinatorial explosion)
    prod = list(itertools.product(*options_per_block))
    if len(prod) > 4:
        prod = prod[:4]

    best_res = None
    for local_picks in prod:
        global_picks = [offsets[j] + local_picks[j] for j in range(k)]
        ckey = (tuple(origins), tuple(local_picks))
        if ckey not in cache:
            priced = []
            for w in sweeps:
                p = _price_picks(ref, w, global_picks)
                if p is not None:
                    priced.append((w, p[0], p[1]))
            cache[ckey] = _pareto(priced)
        cols = cache[ckey]
        if not cols:
            continue
        ok, w = _leaf_lp(cols, origins, lo, hi, s, m)
        if ok:
            return cols, local_picks, w
        if best_res is None:
            best_res = (cols, local_picks, w)
    return best_res


def _staircase(v, m, k, axis, deadline, cache):
    s = m - 2
    leaves, l = [], 1
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        origins = [1] * k
        origins[axis] = min(l, MAX_ORIGIN)
        lo = [1] * k
        lo[axis] = l
        cand = _get_leaf_candidate(v, origins, deadline, cache, lo, [None] * k, s, m)
        if cand is None:
            return None
        cols, picks, w = cand
        if w is not None:
            leaves.append((_leaf(cols, origins, picks, w), None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree
        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None
        lo_h, hi_h, best = l, MAX_CUT, None
        while lo_h <= hi_h:
            mid = (lo_h + hi_h) // 2
            hi = [None] * k
            hi[axis] = mid
            cand_mid = _get_leaf_candidate(v, origins, deadline, cache, lo, hi, s, m)
            if cand_mid is not None and cand_mid[2] is not None:
                best = (mid, cand_mid[0], cand_mid[1], cand_mid[2])
                lo_h = mid + 1
            else:
                hi_h = mid - 1
        if best is None:
            return None
        leaves.append((_leaf(best[1], origins, best[2], best[3]), best[0]))
        l = best[0] + 1
    return None


def pool(v):
    n, m = len(v), max(v)
    r = n - m
    words = {}
    if r <= 4:
        perms = list(itertools.permutations(range(r)))
    else:
        perms = [[(s + i) % r for i in range(r)] for s in range(r)] + [
            [(s + r - 1 - i) % r for i in range(r)] for s in range(r)
        ]
    for t in range(n):
        for perm in perms:
            for rem in _lifts(v, t, perm, m, r):
                for c_start in (0, t) if t != 0 else (0,):
                    for mode in ('L', 'R', 'greedy', 'greedy_R', 'bounce_L', 'bounce_R'):
                        w = _sweep(v, rem, t, mode, c_start=c_start)
                        if w is None:
                            continue
                        w = _reduce(w)
                        if w not in words and len(w) <= 4000:
                            cost = price(v, w)
                            if cost is not None:
                                words[w] = cost
    return words


def _build_root_words(v):
    words = pool(v)
    if not words:
        return []
    word_list = list(words.keys())
    m = max(v)
    k = sum(1 for x in v if x == 0)
    T = _budget(m, k)
    costs = []
    for w in word_list:
        B, beta = words[w]
        costs.append([B - T] + [b - (m - 2) for b in beta])
    n_words = len(word_list)
    dim = k + 1
    hull_indices = set()
    for d in range(dim):
        hull_indices.add(min(range(n_words), key=lambda i: (costs[i][d], max(costs[i]))))
    for j in range(1, dim):
        pts = sorted(range(n_words), key=lambda i: (costs[i][0], costs[i][j]))
        lower = []
        for p in pts:
            while len(lower) >= 2:
                p1, p2 = lower[-2], lower[-1]
                dx1, dy1 = costs[p2][0] - costs[p1][0], costs[p2][j] - costs[p1][j]
                dx2, dy2 = costs[p][0] - costs[p1][0], costs[p][j] - costs[p1][j]
                if dx1 * dy2 - dy1 * dx2 <= 0:
                    lower.pop()
                else:
                    break
            lower.append(p)
        for idx in lower:
            hull_indices.add(idx)
        for ratio in (0.1, 0.25, 0.5, 1.0, 2.0, 4.0, 10.0):
            hull_indices.add(min(range(n_words), key=lambda i: costs[i][0] + ratio * costs[i][j]))
    for alpha in (1.5, 3.0, 5.0):
        for start_mode in ('min_max', 'min_b'):
            cur_idx = min(range(n_words), key=lambda i: (max(costs[i]), costs[i][0])) if start_mode == 'min_max' else min(range(n_words), key=lambda i: (costs[i][0], max(costs[i])))
            cur_vec = list(costs[cur_idx])
            hull_indices.add(cur_idx)
            for it in range(1, 40):
                mx = max(cur_vec)
                exps = [math.exp(min(50.0, alpha * (val - mx))) for val in cur_vec]
                tot = sum(exps)
                weights = [e / tot for e in exps]
                best_i = min(range(n_words), key=lambda i: sum(weights[d] * costs[i][d] for d in range(dim)))
                hull_indices.add(best_i)
                gamma = 2.0 / (it + 2)
                for d in range(dim):
                    cur_vec[d] = (1.0 - gamma) * cur_vec[d] + gamma * costs[best_i][d]
    ordered = sorted(hull_indices, key=lambda i: (max(costs[i]), costs[i][0], sum(costs[i])))
    selected_indices = list(ordered[:KEEP])
    if len(selected_indices) < KEEP:
        by_max = sorted(range(n_words), key=lambda i: (max(costs[i]), costs[i][0]))
        for idx in by_max:
            if idx not in selected_indices:
                selected_indices.append(idx)
                if len(selected_indices) >= KEEP:
                    break
    return [word_list[i] for i in selected_indices[:KEEP]]


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
    m, k = max(v), sum(1 for x in v if x == 0)
    root_words = _build_root_words(v)
    root = {'words': root_words, 'origins': [1] * k}
    base = []
    for w in root_words:
        p = price(v, w)
        if p is not None:
            base.append((w, p[0], p[1]))
    if base and _leaf_lp(base, [1] * k, [1] * k, [None] * k, m - 2, m)[0]:
        return {'tree': root, 'note': 'unit root leaf'}

    cache = {}
    unit_words = pool(v)
    unit_priced = [(w, B, beta) for w, (B, beta) in unit_words.items()]
    unit = _pareto(unit_priced)
    if unit:
        cache[(tuple([1] * k), tuple([0] * k))] = unit
        ok_all, w_all = _leaf_lp(unit, [1] * k, [1] * k, [None] * k, m - 2, m)
        if ok_all:
            return {'tree': _leaf(unit, [1] * k, [0] * k, w_all), 'note': 'full unit pool leaf'}

    load = [min(beta[j] for _, _, beta in unit) if unit else 0 for j in range(k)]
    sorted_axes = sorted(range(k), key=lambda j: (-load[j], j))

    for axis in sorted_axes:
        if _time.process_time() > deadline:
            break
        tree = _staircase(v, m, k, axis, deadline, cache)
        if tree is not None:
            return {'tree': tree, 'note': f'staircase axis {axis}'}

    return {'tree': root, 'note': 'fallback root'}
