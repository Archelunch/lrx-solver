    dim = k + 1
    selected = set()

    for d in range(dim):
        best_idx = min(range(n_words), key=lambda i: (costs[i][d], max(costs[i])))
        selected.add(best_idx)

    for j in range(1, dim):
        pts = sorted(range(n_words), key=lambda i: (costs[i][0], costs[i][j]))
        lower = []
        for p in pts:
            while len(lower) >= 2:
                p1, p2 = lower[-2], lower[-1]
                dx1, dy1 = costs[p2][0] - costs[p1][0], costs[p2][j] - costs[p1][j]
                dx2, dy2 = costs[p][0] - costs[p1][0], costs[p][j] - costs[p1][j]
                if dx1 * dy2 - dy1 * dx2 <= 0:
                    lower.pop()
                else:
                    break
            lower.append(p)
        for idx in lower:
            selected.add(idx)

    for j in range(1, dim):
        for ratio in (0.1, 0.25, 0.5, 1.0, 2.0, 4.0, 10.0):
            best_idx = min(range(n_words), key=lambda i: costs[i][0] + ratio * costs[i][j])
            selected.add(best_idx)

    for alpha in (1.5, 3.0):
        for start_mode in ('min_max', 'min_b'):
            if start_mode == 'min_max':
                cur_idx = min(range(n_words), key=lambda i: (max(costs[i]), costs[i][0]))
            else:
                cur_idx = min(range(n_words), key=lambda i: (costs[i][0], max(costs[i])))
            cur_vec = list(costs[cur_idx])
            selected.add(cur_idx)
            for it in range(1, 35):
                mx = max(cur_vec)
                exps = [min(1e15, 2.718281828459045 ** min(40.0, alpha * (val - mx))) for val in cur_vec]
                tot = sum(exps)
                weights = [e / tot for e in exps]
                best_i = min(range(n_words), key=lambda i: sum(weights[d] * costs[i][d] for d in range(dim)))
                selected.add(best_i)
                gamma = 2.0 / (it + 2)
                for d in range(dim):
                    cur_vec[d] = (1.0 - gamma) * cur_vec[d] + gamma * costs[best_i][d]

    ordered = sorted(selected, key=lambda i: (max(costs[i]), costs[i][0], sum(costs[i])))
    selected_indices = list(ordered[:KEEP])
    if len(selected_indices) < KEEP:
        by_max = sorted(range(n_words), key=lambda i: (max(costs[i]), costs[i][0]))
        for idx in by_max:
            if idx not in selected_indices:
                selected_indices.append(idx)
                if len(selected_indices) >= KEEP:
                    break

    res_words = [word_list[i] for i in selected_indices[:KEEP]]
    root = {'words': res_words, 'origins': [1] * k}

    root_cols = [(w, unit_words[w][0], unit_words[w][1]) for w in res_words]
    ok_root, _ = _leaf_lp(root_cols, [1] * k, [1] * k, [None] * k, m - 2, m)
    if ok_root:
        return {'tree': root}

    raw_words_cache = {tuple([1] * k): (v, [w for w, _ in root_cols])}
    unit_pareto = _pareto([(w, cost[0], cost[1]) for w, cost in unit_words.items()])
    raw_words_cache[tuple([1] * k)] = (v, [w for w, _, _ in unit_pareto])

    load = [min(beta[j] for _, _, beta in unit_pareto) if unit_pareto else 0 for j in range(k)]
    sorted_axes = sorted(range(k), key=lambda j: (-load[j], j))

    for axis in sorted_axes:
        if _time.process_time() > deadline:
            break
        tree = _staircase(v, m, k, axis, deadline, raw_words_cache)
        if tree is not None:
            return {'tree': tree}

    return {'tree': root}
