        ok, w = _leaf_lp(unit_words, [1] * k, [1] * k, [None] * k, m - 2, m)
        if ok:
            return {'tree': _leaf(unit_words, [1] * k, w, [0] * k)}

    load = [min(col[2][j] for col in unit_words) if unit_words else 0 for j in range(k)]
    sorted_axes = sorted(range(k), key=lambda j: (-load[j], j))

    for axis in sorted_axes:
        if _time.process_time() > deadline:
            break
        tree = _build_staircase(v, m, k, axis, 1, deadline, cache)
        if tree is not None:
            return {'tree': tree, 'note': f'staircase on axis {axis}'}

    if k >= 2 and _time.process_time() < deadline - 0.4:
        ax1, ax2 = sorted_axes[0], sorted_axes[1]
        cols = _columns(v, [1] * k, deadline, cache)
        if cols:
            best_t = None
            for t1 in range(1, 4):
                ok, _ = _leaf_lp(cols, [1] * k, [1] * k, [t1 if j == ax1 else None for j in range(k)], m - 2, m)
                if ok:
                    best_t = t1
                else:
                    break
            if best_t is not None:
                ok, w_le = _leaf_lp(cols, [1] * k, [1] * k, [best_t if j == ax1 else None for j in range(k)], m - 2, m)
                if ok:
                    node_le = _leaf(cols, [1] * k, w_le, [0] * k)
                    node_ge = _build_staircase(v, m, k, ax2, 1, deadline, cache, max_depth=6)
                    if node_ge is not None:
                        return {'tree': {'j': ax1, 't': best_t, 'le': node_le, 'ge': node_ge}, 'note': f'2-axis {ax1} then {ax2}'}

    root_words = unit_words[:KEEP] if unit_words else []
    return {'tree': {'words': [col[0] for col in root_words], 'origins': [1] * k}}
