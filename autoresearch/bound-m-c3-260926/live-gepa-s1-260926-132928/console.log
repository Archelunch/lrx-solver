def _staircase(v, m, k, axis, deadline, cache, max_o=MAX_ORIGIN):
    s = m - 2
    leaves, l = [], 1
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        target_o = min(l, max_o)
