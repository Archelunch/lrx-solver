    for w, B, beta in unit:
        costs.append([B - T] + [b - s for b in beta])
    n_words = len(unit)
    dim = k + 1

    selected = set()
    for d in range(dim):
        best_idx = min(range(n_words), key=lambda i: (costs[i][d], max(costs[i])))
        selected.add(best_idx)

    for j in range(1, dim):
        pts = sorted(range(n_words), key=lambda i: (costs[i][0], costs[i][j]))
        lower = []
        for p in pts:
            while len(lower) >= 2:
                p1, p2 = lower[-2], lower[-1]
                dx1, dy1 = costs[p2][0] - costs[p1][0], costs[p2][j] - costs[p1][j]
                dx2, dy2 = costs[p][0] - costs[p1][0], costs[p][j] - costs[p1][j]
                if dx1 * dy2 - dy1 * dx2 <= 0:
                    lower.pop()
                else:
                    break
            lower.append(p)
        for idx in lower:
            selected.add(idx)

    for j in range(1, dim):
        for ratio in (0.1, 0.25, 0.5, 1.0, 2.0, 4.0, 10.0):
            best_idx = min(range(n_words), key=lambda i: costs[i][0] + ratio * costs[i][j])
            selected.add(best_idx)

    for alpha in (1.5, 3.0):
        for start_mode in ('min_max', 'min_b'):
            if start_mode == 'min_max':
                cur_idx = min(range(n_words), key=lambda i: (max(costs[i]), costs[i][0]))
            else:
                cur_idx = min(range(n_words), key=lambda i: (costs[i][0], max(costs[i])))
            cur_vec = list(costs[cur_idx])
            selected.add(cur_idx)
            for it in range(1, 40):
                mx = max(cur_vec)
                exps = [math.exp(min(50.0, alpha * (val - mx))) for val in cur_vec]
                tot = sum(exps)
                weights = [e / tot for e in exps]
                best_i = min(range(n_words), key=lambda i: sum(weights[d] * costs[i][d] for d in range(dim)))
                selected.add(best_i)
                gamma = 2.0 / (it + 2)
                for d in range(dim):
                    cur_vec[d] = (1.0 - gamma) * cur_vec[d] + gamma * costs[best_i][d]

    ordered = sorted(selected, key=lambda i: (max(costs[i]), costs[i][0], sum(costs[i])))
    root_words = [unit[i][0] for i in ordered[:KEEP]]
    root = {'words': root_words, 'origins': [1] * k}

    base = [unit[i] for i in ordered[:KEEP]]
    ok, _ = _leaf_lp(base, [1] * k, [1] * k, [None] * k, s, m)
    if ok:
        return {'tree': root, 'note': 'unit root certified'}

    load = [min(beta[j] for _, _, beta in unit) if unit else 0 for j in range(k)]
    axes = sorted(range(k), key=lambda j: (-load[j], j))

    for axis in axes:
        if _time.process_time() > deadline:
            break
        tree = _staircase(v, m, k, axis, deadline, cache)
        if tree is not None:
            return {'tree': tree, 'note': 'staircase axis %d' % axis}

    if k >= 2 and len(axes) >= 2:
        a1, a2 = axes[0], axes[1]
        for t1 in (1, 2, 3):
            if _time.process_time() > deadline:
                break
            left = _staircase(v, m, k, a2, deadline, cache, lo_box=[1] * k)
            if left is None:
                continue
            right_lo = [1] * k
            right_lo[a1] = t1 + 1
            right = _staircase(v, m, k, a1, deadline, cache, lo_box=right_lo)
            if right is not None:
                tree = {'j': a1, 't': t1, 'le': left, 'ge': right}
                return {'tree': tree, 'note': '2-axis split (%d, %d)' % (a1, a2)}

    return {'tree': root, 'note': 'root fallback'}
