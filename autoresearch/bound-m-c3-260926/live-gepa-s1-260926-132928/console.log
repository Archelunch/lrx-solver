    if base and _leaf_lp(base, [1] * k, [1] * k, [None] * k, m - 2, m)[0]:
        return {'tree': root}

    cache = {}
    unit_pareto = _pareto([(w, B, beta) for w, (B, beta) in unit_words_dict.items()])
    cache[(tuple([1] * k), tuple([0] * k))] = unit_pareto

    # Estimate axis load
    s = m - 2
    load = []
    for j in range(k):
        min_b = min(beta[j] for _, _, beta in unit_pareto)
        avg_b = sum(beta[j] for _, _, beta in unit_pareto) / len(unit_pareto)
        load.append(min_b - s + 0.1 * avg_b)

    sorted_axes = sorted(range(k), key=lambda j: (-load[j], j))

    for axis in sorted_axes:
        if _time.process_time() > deadline:
            break
        tree = _staircase(v, m, k, axis, deadline, cache)
        if tree is not None:
            return {'tree': tree, 'note': f'staircase on axis {axis}'}

    return {'tree': root, 'note': 'root fallback'}
