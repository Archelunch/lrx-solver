    if not cols:
        return False, None, None, None

    ok, weights = _leaf_lp(cols, origins, lo, hi, s, m)
    if not ok:
        return False, None, None, None

    leaf_node = _make_leaf(cols, origins, best_picks, weights)
    return True, leaf_node, weights, cols


def _build_staircase(v, m, k, axis, deadline, cache):
    s = m - 2
    leaves, l = [], 1
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        origins = [1] * k
        origins[axis] = min(l, MAX_ORIGIN)
        lo = [1] * k
        lo[axis] = l
        ok, leaf_node, _, _ = _evaluate_leaf(v, origins, lo, [None] * k, s, m, deadline, cache)
        if ok:
