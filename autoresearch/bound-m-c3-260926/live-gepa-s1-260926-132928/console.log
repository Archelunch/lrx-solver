import itertools
import math
import time as _time

KEEP = 32
MAX_ORIGIN = 5
MAX_CUT = 12
MAX_STEPS = 8
LEAF_WORDS = 24
CPU_BUDGET = 2.65
EPS = 1e-9


def _reduce(word):
    out = []
    for ch in word:
        if out and out[-1] + ch in ('LR', 'RL', 'XX'):
            out.pop()
        else:
            out.append(ch)
    return ''.join(out)


def _lifts(v, t, perm, m, r):
    n = len(v)
    zeros = [p for p in range(n) if v[p] == 0]
    target = [0] * n
    for p in range(n):
        if v[p]:
            target[p] = (t + v[p] - 1) % n
    for i in range(r):
        target[zeros[i]] = (t + m + perm[i]) % n

    lift_bases = []
    base1 = [((target[p] - p + n // 2) % n) - n // 2 for p in range(n)]
    lift_bases.append(base1)
    if n % 2 == 0:
        base2 = [((target[p] - p + n // 2 - 1) % n) - (n // 2 - 1) for p in range(n)]
        if base2 != base1:
            lift_bases.append(base2)

    res = []
    for rem_base in lift_bases:
        q = sum(rem_base) // n
        if q == 0:
            if rem_base not in res:
                res.append(rem_base)
            continue
        for rev_tie in (False, True):
            rem = list(rem_base)
            order = sorted(range(n), key=lambda p: (rem[p], -p if rev_tie else p), reverse=q > 0)
            for p in order[:abs(q)]:
                rem[p] -= n if q > 0 else -n
            if rem not in res:
                res.append(rem)
    return res


def _sweep(v, rem, t, mode, c_start=0, limit=4000):
    n = len(v)
    a, rem = list(v), list(rem)
    out = []
    c = 0
    if c_start != 0:
        d = c_start % n
        out.append('L' * d if d <= n - d else 'R' * (n - d))
        c = c_start % n

    def must_cross(x):
        return rem[x] - rem[(x + 1) % n] >= 2

    def cross(x):
        y = (x + 1) % n
        rx, ry = rem[x], rem[y]
        if a[x] or a[y]:
            out.append('X')
            a[x], a[y] = a[y], a[x]
        rem[x], rem[y] = ry + 1, rx - 1

    bounce_dir = 1 if mode == 'bounce_L' else -1
    bounce_steps = 0
    while any(rem) and len(out) < limit:
        if mode.startswith('greedy'):
            dirs = (1, -1) if mode == 'greedy' else (-1, 1)
            for dist in range(n):
                found = False
                for sgn in dirs:
                    pos = (c + sgn * dist) % n
                    if must_cross(pos):
                        out.append(('L' if sgn == 1 else 'R') * dist)
                        c = pos
                        found = True
                        break
                if found:
                    break
            else:
                return None
            cross(c)
            continue
        elif mode.startswith('bounce'):
            if must_cross(c):
                cross(c)
                if not any(rem):
                    break
            step_ch = 'L' if bounce_dir == 1 else 'R'
            out.append(step_ch)
            c = (c + bounce_dir) % n
            bounce_steps += 1
            if bounce_steps >= n - 1:
                bounce_dir = -bounce_dir
                bounce_steps = 0
            continue
        if must_cross(c):
            cross(c)
            if not any(rem):
                break
        out.append(mode)
        c = (c + (1 if mode == 'L' else -1)) % n
    if any(rem):
        return None
    d = (t - c) % n
    out.append('L' * d if d <= n - d else 'R' * (n - d))
    return ''.join(out)


def price(v, word):
    n, k = len(v), sum(1 for x in v if x == 0)
    a, j = [], 0
    for x in v:
        if x:
            a.append(x)
        else:
            j += 1
            a.append(-j)
    segs, A, q, d, cz, c = [], [0] * k, 0, 0, [0] * k, 0
    for ch in word:
        if ch == 'L':
            d += 1
            if a[c] < 0:
                cz[-a[c] - 1] += 1
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            d -= 1
            if a[c] < 0:
                cz[-a[c] - 1] -= 1
        else:
            c2 = (c + 1) % n
            x, y = a[c], a[c2]
            if x < 0 and y < 0:
                return None
            q += 1
            nxt = [0] * k
            if x < 0:
                cz[-x - 1] += 1
                A[-x - 1] += 1
            elif y < 0:
                A[-y - 1] += 1
                nxt[-y - 1] = -1
            segs.append((d, cz))
            d, cz = 0, nxt
            a[c], a[c2] = y, x
    segs.append((d, cz))
    fin = a[c:] + a[:c]
    m = n - k
    if fin[:m] != list(range(1, m + 1)):
        return None
    B = q + sum(abs(s) for s, _ in segs)
    beta = [2 * A[i] + sum(abs(z[i]) for _, z in segs) for i in range(k)]
    return B, beta


def _budget(m, r):
    return m * (m + 1) // 2 + (r - 1) * (m - 2)


def _refine(v, origins):
    out, j = [], 0
    for x in v:
        if x:
            out.append(x)
        else:
            out.extend([0] * origins[j])
            j += 1
    return out


def _price_all_atoms(v, word):
    """Calculates B and beta for all zero atoms simultaneously.
    Returns (B, beta_all) or None if invalid word or zero-zero swap."""
    n = len(v)
    a, g = [], 0
    for x in v:
        if x:
            a.append(x)
        else:
            a.append(-1 - g)
            g += 1
    m = n - g
    num_zeros = g
    A, q, d, cz, c = [0] * num_zeros, 0, 0, [0] * num_zeros, 0
    segs = []
    for ch in word:
        if ch == 'L':
            d += 1
            if a[c] < 0:
                cz[-1 - a[c]] += 1
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            d -= 1
            if a[c] < 0:
                cz[-1 - a[c]] -= 1
        else:
            c2 = (c + 1) % n
            x, y = a[c], a[c2]
            if x < 0 and y < 0:
                return None
            q += 1
            nxt = [0] * num_zeros
            if x < 0:
                cz[-1 - x] += 1
                A[-1 - x] += 1
            elif y < 0:
                A[-1 - y] += 1
                nxt[-1 - y] = -1
            segs.append((d, cz))
            d, cz = 0, nxt
            a[c], a[c2] = y, x
    segs.append((d, cz))
    fin = a[c:] + a[:c]
    if fin[:m] != list(range(1, m + 1)):
        return None
    B = q + sum(abs(s) for s, _ in segs)
    beta = [2 * A[i] + sum(abs(z[i]) for _, z in segs) for i in range(num_zeros)]
    return B, beta


def _sweep_words(v, deadline):
    n, m = len(v), max(v)
    r = n - m
    if r <= 4:
        perms = list(itertools.permutations(range(r)))
    elif r <= 6:
        perms = [[(s + i) % r for i in range(r)] for s in range(r)] + [
            [(s + r - 1 - i) % r for i in range(r)] for s in range(r)]
        for s in range(r):
            p = [(s + i) % r for i in range(r)]
            p[0], p[1] = p[1], p[0]
            perms.append(p)
            p2 = [(s + r - 1 - i) % r for i in range(r)]
            p2[0], p2[1] = p2[1], p2[0]
            perms.append(p2)
    else:
        perms = [[(s + i) % r for i in range(r)] for s in range(r)] + [
            [(s + r - 1 - i) % r for i in range(r)] for s in range(r)]

    words = set()
    for t in range(n):
        if _time.process_time() > deadline:
            break
        for perm in perms:
            for rem in _lifts(v, t, perm, m, r):
                for c_start in (0, t) if t != 0 else (0,):
                    for mode in ('L', 'R', 'greedy', 'greedy_R', 'bounce_L', 'bounce_R'):
                        w = _sweep(v, rem, t, mode, c_start=c_start)
                        if w is not None:
                            w = _reduce(w)
                            if len(w) <= 4000:
                                words.add(w)
    return sorted(words, key=lambda w: (len(w), w))


def _simplex(A, b, c):
    rows, cols = len(A), len(c)
    T = []
    for i in range(rows):
        s = -1.0 if b[i] < 0 else 1.0
        T.append([s * x for x in A[i]] + [1.0 if r == i else 0.0 for r in range(rows)] + [s * b[i]])
    basis = list(range(cols, cols + rows))

    def pivot(r, j):
        p = T[r][j]
        T[r] = [x / p for x in T[r]]
        for i in range(rows):
            if i != r and abs(T[i][j]) > 1e-15:
                f = T[i][j]
                T[i] = [x - f * y for x, y in zip(T[i], T[r])]
        basis[r] = j

    def run(cost, allowed):
        for _ in range(2500):
            enter = None
            for j in allowed:
                if j in basis:
                    continue
                if cost[j] - sum(cost[basis[i]] * T[i][j] for i in range(rows)) < -EPS:
                    enter = j
                    break
            if enter is None:
                return True
            cand = [i for i in range(rows) if T[i][enter] > EPS]
            if not cand:
                return False
            r = min(cand, key=lambda i: (T[i][-1] / T[i][enter], basis[i]))
            pivot(r, enter)
        return False

    if not run([0.0] * cols + [1.0] * rows, range(cols + rows)):
        return None
    if sum(T[i][-1] for i in range(rows) if basis[i] >= cols) > 1e-7:
        return None
    for r in range(rows):
        if basis[r] >= cols:
            j = next((j for j in range(cols) if abs(T[r][j]) > EPS and j not in basis), None)
            if j is not None:
                pivot(r, j)
    if not run(list(c) + [0.0] * rows, range(cols)):
        return None
    x = [0.0] * cols
    for i, j in enumerate(basis):
        if j < cols:
            x[j] = T[i][-1]
    return x, sum(ci * xi for ci, xi in zip(c, x))


def _leaf_lp(cols, origins, lo, hi, s, m):
    k = len(lo)
    n = len(cols)
    bnd = [j for j in range(k) if hi[j] is not None]
    T = _budget(m, sum(lo))
    cost = [B + sum(b * (l - o) for b, l, o in zip(beta, lo, origins)) for _, B, beta in cols]
    A = []
    for j in range(k):
        A.append([beta[j] for _, _, beta in cols] + [-1.0 if bj == j else 0.0 for bj in bnd]
                 + [1.0 if i == j else 0.0 for i in range(k)])
    A.append([1.0] * n + [0.0] * (len(bnd) + k))
    c = cost + [hi[j] - lo[j] for j in bnd] + [0.0] * k
    out = _simplex(A, [float(s)] * k + [1.0], c)
    if out is None:
        return False, None
    x, val = out
    return val < T + 1 - 1e-6, x[:n]


def _filter_pareto(priced):
    best = {}
    for w, B, beta in priced:
        key = (B,) + tuple(beta)
        if key not in best or len(w) < len(best[key]):
            best[key] = w
    keys = sorted(best)
    keep = []
    for x in keys:
        if not any(all(p <= q for p, q in zip(y, x)) for y in keep):
            keep.append(x)
    return [(best[x], x[0], list(x[1:])) for x in keep]


def _leaf(cols, origins, weights, picks=None):
    order = sorted(range(len(cols)), key=lambda i: (-weights[i], cols[i][1], i))
    words = [cols[i][0] for i in order if weights[i] > 1e-12]
    for i in order:
        if len(words) >= LEAF_WORDS:
            break
        if cols[i][0] not in words:
            words.append(cols[i][0])
    res = {'words': words[:LEAF_WORDS], 'origins': list(origins)}
    if picks is not None and any(p != 0 for p in picks):
        res['picks'] = list(picks)
    return res


def _get_evaluated_words(v, origins, deadline, raw_cache):
    key = tuple(origins)
    if key not in raw_cache:
        ref = _refine(v, origins)
        evals = []
        for w in _sweep_words(ref, deadline):
            res = _price_all_atoms(ref, w)
            if res is not None:
                evals.append((w, res[0], res[1]))
        raw_cache[key] = evals
    return raw_cache[key]


def _build_leaf_for_box(v, m, k, origins, lo, hi, deadline, raw_cache):
    evals = _get_evaluated_words(v, origins, deadline, raw_cache)
    if not evals:
        return False, None

    picks_candidates = []
    def rec(blk_idx, cur):
        if blk_idx == k:
            picks_candidates.append(tuple(cur))
            return
        if origins[blk_idx] == 1:
            rec(blk_idx + 1, cur + [0])
        else:
            for p in range(origins[blk_idx]):
                rec(blk_idx + 1, cur + [p])
    rec(0, [])

    s = m - 2
    for pick_cand in picks_candidates:
        blk_offsets = []
        cur_tot = 0
        for o in origins:
            blk_offsets.append(cur_tot)
            cur_tot += o
        global_picks = [blk_offsets[j] + pick_cand[j] for j in range(k)]

        priced = [(w, B, [beta_all[gp] for gp in global_picks]) for w, B, beta_all in evals]
        cols = _filter_pareto(priced)
        if not cols:
            continue
        ok, w = _leaf_lp(cols, origins, lo, hi, s, m)
        if ok:
            return True, _leaf(cols, origins, w, pick_cand)
    return False, None


def _staircase_on_axis(v, m, k, axis, deadline, raw_cache):
    s = m - 2
    leaves, l = [], 1
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        best_unbounded = None
        for cand_origin in range(min(l, MAX_ORIGIN), 0, -1):
            origins = [1] * k
            origins[axis] = cand_origin
            lo = [1] * k
            lo[axis] = l
            ok, leaf_node = _build_leaf_for_box(v, m, k, origins, lo, [None] * k, deadline, raw_cache)
            if ok:
                best_unbounded = leaf_node
                break

        if best_unbounded is not None:
            leaves.append((best_unbounded, None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree

        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None

        lo_h, hi_h, best_bounded = l, MAX_CUT, None
        while lo_h <= hi_h and _time.process_time() < deadline:
            mid = (lo_h + hi_h) // 2
            passed_mid, best_mid_leaf = False, None
            for cand_origin in range(min(l, MAX_ORIGIN), 0, -1):
                origins = [1] * k
                origins[axis] = cand_origin
                lo = [1] * k
                lo[axis] = l
                hi = [None] * k
                hi[axis] = mid
                ok, leaf_node = _build_leaf_for_box(v, m, k, origins, lo, hi, deadline, raw_cache)
                if ok:
                    passed_mid = True
                    best_mid_leaf = leaf_node
                    break
            if passed_mid:
                best_bounded = (mid, best_mid_leaf)
                lo_h = mid + 1
            else:
                hi_h = mid - 1

        if best_bounded is None:
            return None
        leaves.append((best_bounded[1], best_bounded[0]))
        l = best_bounded[0] + 1
    return None


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
    m, k = max(v), sum(1 for x in v if x == 0)
    raw_cache = {}

    ok, root_leaf = _build_leaf_for_box(v, m, k, [1] * k, [1] * k, [None] * k, deadline, raw_cache)
    if ok:
        return {'tree': root_leaf, 'note': 'unit root certified'}

    unit_evals = _get_evaluated_words(v, [1] * k, deadline, raw_cache)
    if unit_evals:
        min_slopes = [min(b[j] for _, _, b in unit_evals) for j in range(k)]
        axes_order = sorted(range(k), key=lambda j: (-min_slopes[j], j))
    else:
        axes_order = list(range(k))

    for axis in axes_order:
        if _time.process_time() > deadline:
            break
        tree = _staircase_on_axis(v, m, k, axis, deadline, raw_cache)
        if tree is not None:
            return {'tree': tree, 'note': 'staircase on axis %d' % axis}

    fallback = root_leaf if root_leaf is not None else {'words': [], 'origins': [1] * k}
    return {'tree': fallback, 'note': 'timeout or unresolved'}
