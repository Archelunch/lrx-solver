        perms = [[(s + i) % r for i in range(r)] for s in range(r)] + [
            [(s + r - 1 - i) % r for i in range(r)] for s in range(r)]
    words = set()
    for t in range(n):
        if _time.process_time() > deadline:
            break
        for perm in perms:
            for rem in _lifts(v, t, perm, m, r):
                for c_start in (0, t) if t != 0 else (0,):
                    for mode in ('L', 'R', 'greedy', 'greedy_R', 'bounce_L', 'bounce_R'):
                        w = _sweep(v, rem, t, mode, c_start=c_start)
                        if w is not None:
                            w = _reduce(w)
                            if len(w) <= 4000:
                                words.add(w)
    return sorted(words, key=lambda w: (len(w), w))


def _pareto(priced):
    best = {}
    for w, B, beta in priced:
        key = (B,) + tuple(beta)
        if key not in best or len(w) < len(best[key]):
            best[key] = w
    keys = sorted(best)
    keep = []
    for x in keys:
        if not any(all(p <= q for p, q in zip(y, x)) for y in keep):
            keep.append(x)
    return [(best[x], x[0], list(x[1:])) for x in keep]


def _simplex(A, b, c):
    rows, cols = len(A), len(c)
    T = []
    for i in range(rows):
        s = -1.0 if b[i] < 0 else 1.0
        T.append([s * x for x in A[i]] + [1.0 if r == i else 0.0 for r in range(rows)] + [s * b[i]])
    basis = list(range(cols, cols + rows))

    def pivot(r, j):
        p = T[r][j]
        T[r] = [x / p for x in T[r]]
        for i in range(rows):
            if i != r and abs(T[i][j]) > 1e-15:
                f = T[i][j]
                T[i] = [x - f * y for x, y in zip(T[i], T[r])]
        basis[r] = j

    def run(cost, allowed):
        for _ in range(2500):
            enter = None
            for j in allowed:
                if j in basis:
                    continue
                if cost[j] - sum(cost[basis[i]] * T[i][j] for i in range(rows)) < -EPS:
                    enter = j
                    break
            if enter is None:
                return True
            cand = [i for i in range(rows) if T[i][enter] > EPS]
            if not cand:
                return False
            r = min(cand, key=lambda i: (T[i][-1] / T[i][enter], basis[i]))
            pivot(r, enter)
        return False

    if not run([0.0] * cols + [1.0] * rows, range(cols + rows)):
        return None
    if sum(T[i][-1] for i in range(rows) if basis[i] >= cols) > 1e-7:
        return None
    for r in range(rows):
        if basis[r] >= cols:
            j = next((j for j in range(cols) if abs(T[r][j]) > EPS and j not in basis), None)
            if j is not None:
                pivot(r, j)
    if not run(list(c) + [0.0] * rows, range(cols)):
        return None
    x = [0.0] * cols
    for i, j in enumerate(basis):
        if j < cols:
            x[j] = T[i][-1]
    return x, sum(ci * xi for ci, xi in zip(c, x))


def _leaf_lp(cols, origins, lo, hi, s, m):
    k = len(lo)
    n = len(cols)
    if n == 0:
        return False, None, 999.0
    bnd = [j for j in range(k) if hi[j] is not None]
    T = _budget(m, sum(lo))
    cost = [B + sum(b * (l - o) for b, l, o in zip(beta, lo, origins)) for _, B, beta in cols]
    A = []
    for j in range(k):
        A.append([beta[j] for _, _, beta in cols] + [-1.0 if bj == j else 0.0 for bj in bnd]
                 + [1.0 if i == j else 0.0 for i in range(k)])
    A.append([1.0] * n + [0.0] * (len(bnd) + k))
    c = cost + [hi[j] - lo[j] for j in bnd] + [0.0] * k
    out = _simplex(A, [float(s)] * k + [1.0], c)
    if out is None:
        return False, None, 999.0
    x, val = out
    gap = val - (T + 1 - 1e-6)
    return val < T + 1 - 1e-6, x[:n], gap


def _leaf(cols, origins, picks_local, weights):
    order = sorted(range(len(cols)), key=lambda i: (-weights[i], cols[i][1], i))
    words = [cols[i][0] for i in order if weights[i] > 1e-12]
    for i in order:
        if len(words) >= LEAF_WORDS:
            break
        if cols[i][0] not in words:
            words.append(cols[i][0])
    res = {'words': words[:LEAF_WORDS], 'origins': list(origins)}
    if picks_local is not None and any(p != 0 for p in picks_local):
        res['picks'] = list(picks_local)
    return res


def _columns(v, origins, deadline, cache):
    key = tuple(origins)
    if key not in cache:
        ref = _refine(v, origins)
        k = len(origins)
        sweep_w = _sweep_words(ref, deadline)
        variant_cols = []
        # Try local pick configurations on the refined axis
        # For origins where one axis j has o_j > 1, try p in range(o_j)
        split_j = [j for j in range(k) if origins[j] > 1]
        if len(split_j) == 1:
            j_axis = split_j[0]
            cand_picks = range(origins[j_axis])
        else:
            cand_picks = [0]
        
        for p_val in cand_picks:
            local_picks = [0] * k
            if len(split_j) == 1:
                local_picks[split_j[0]] = p_val
            global_picks = [sum(origins[:j]) + local_picks[j] for j in range(k)]
            priced = []
            for w in sweep_w:
                p = _price_picks(ref, w, global_picks)
                if p is not None:
                    priced.append((w, p[0], p[1]))
            variant_cols.append((local_picks, _pareto(priced)))
        cache[key] = variant_cols
    return cache[key]


def _best_variant_lp(v, origins, lo, hi, s, m, deadline, cache):
    variants = _columns(v, origins, deadline, cache)
    best_ok = False
    best_w = None
    best_picks = None
    min_gap = 999.0
    best_cols = None
    for local_picks, cols in variants:
        ok, w, gap = _leaf_lp(cols, origins, lo, hi, s, m)
        if ok:
            return True, cols, origins, local_picks, w, gap
        if gap < min_gap:
            min_gap = gap
            best_w = w
            best_picks = local_picks
            best_cols = cols
    return False, best_cols, origins, best_picks, best_w, min_gap


def _staircase(v, m, k, axis, deadline, cache):
    s = m - 2
    leaves, l = [], 1
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        origins = [1] * k
        origins[axis] = min(l, MAX_ORIGIN)
        lo = [1] * k
        lo[axis] = l
        
        ok, cols, orig, picks, w, gap = _best_variant_lp(v, origins, lo, [None] * k, s, m, deadline, cache)
        if ok:
            leaves.append((_leaf(cols, orig, picks, w), None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree
        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None
        
        lo_h, hi_h, best = l, MAX_CUT, None
        while lo_h <= hi_h:
            mid = (lo_h + hi_h) // 2
            hi = [None] * k
            hi[axis] = mid
            ok, cols, orig, picks, w, gap = _best_variant_lp(v, origins, lo, hi, s, m, deadline, cache)
            if ok:
                best = (mid, cols, orig, picks, w)
                lo_h = mid + 1
            else:
                hi_h = mid - 1
        if best is None:
            return None
        leaves.append((_leaf(best[1], best[2], best[3], best[4]), best[0]))
        l = best[0] + 1
    return None


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
    m, k = max(v), sum(1 for x in v if x == 0)
    s = m - 2

    cache = {}
    ref1 = tuple([1] * k)
    variants = _columns(v, ref1, deadline, cache)
    unit_cols = variants[0][1] if variants else []
    
    if unit_cols:
        ok, w, gap = _leaf_lp(unit_cols, [1] * k, [1] * k, [None] * k, s, m)
        if ok:
            leaf = _leaf(unit_cols, [1] * k, [0] * k, w)
            return {'tree': leaf, 'note': 'unit root certified'}

    # Find axes sorted by bottleneck slope
    load = []
    for j in range(k):
        if unit_cols:
            load.append(min(beta[j] for _, _, beta in unit_cols))
        else:
            load.append(0)
    
    # Try single-axis staircases
    sorted_axes = sorted(range(k), key=lambda j: (-load[j], j))
    for axis in sorted_axes:
        if _time.process_time() > deadline:
            break
        tree = _staircase(v, m, k, axis, deadline, cache)
        if tree is not None:
            return {'tree': tree, 'note': 'staircase on axis %d' % axis}

    # Fallback root leaf
    if unit_cols:
        _, w, _ = _leaf_lp(unit_cols, [1] * k, [1] * k, [None] * k, s, m)
        if w is None:
            w = [1.0 / len(unit_cols)] * len(unit_cols)
        leaf = _leaf(unit_cols, [1] * k, [0] * k, w)
        return {'tree': leaf, 'note': 'fallback unit root'}
    return {'words': []}
