import itertools
import math
import time as _time

KEEP = 32
MAX_ORIGIN = 5
MAX_CUT = 12
MAX_STEPS = 8
LEAF_WORDS = 24
CPU_BUDGET = 2.85
EPS = 1e-9


def _reduce(word):
    out = []
    for ch in word:
        if out and out[-1] + ch in ('LR', 'RL', 'XX'):
            out.pop()
        else:
            out.append(ch)
    return ''.join(out)


def _lifts(v, t, perm, m, r):
    n = len(v)
    zeros = [p for p in range(n) if v[p] == 0]
    target = [0] * n
    for p in range(n):
        if v[p]:
            target[p] = (t + v[p] - 1) % n
    for i in range(r):
        target[zeros[i]] = (t + m + perm[i]) % n

    lift_bases = []
    base1 = [((target[p] - p + n // 2) % n) - n // 2 for p in range(n)]
    lift_bases.append(base1)
    if n % 2 == 0:
        base2 = [((target[p] - p + n // 2 - 1) % n) - (n // 2 - 1) for p in range(n)]
        if base2 != base1:
            lift_bases.append(base2)

    res = []
    for rem_base in lift_bases:
        q = sum(rem_base) // n
        if q == 0:
            if rem_base not in res:
                res.append(rem_base)
            continue
        for rev_tie in (False, True):
            rem = list(rem_base)
            order = sorted(range(n), key=lambda p: (rem[p], -p if rev_tie else p), reverse=q > 0)
            for p in order[:abs(q)]:
                rem[p] -= n if q > 0 else -n
            if rem not in res:
                res.append(rem)
    return res


def _sweep(v, rem, t, mode, c_start=0, limit=4000):
    n = len(v)
    a, rem = list(v), list(rem)
    out = []
    c = 0
    if c_start != 0:
        d = c_start % n
        out.append('L' * d if d <= n - d else 'R' * (n - d))
        c = c_start % n

    def must_cross(x):
        return rem[x] - rem[(x + 1) % n] >= 2

    def cross(x):
        y = (x + 1) % n
        rx, ry = rem[x], rem[y]
        if a[x] or a[y]:
            out.append('X')
            a[x], a[y] = a[y], a[x]
        rem[x], rem[y] = ry + 1, rx - 1

    bounce_dir = 1 if mode == 'bounce_L' else -1
    bounce_steps = 0
    while any(rem) and len(out) < limit:
        if mode.startswith('greedy'):
            dirs = (1, -1) if mode == 'greedy' else (-1, 1)
            for dist in range(n):
                found = False
                for sgn in dirs:
                    pos = (c + sgn * dist) % n
                    if must_cross(pos):
                        out.append(('L' if sgn == 1 else 'R') * dist)
                        c = pos
                        found = True
                        break
                if found:
                    break
            else:
                return None
            cross(c)
            continue
        elif mode.startswith('bounce'):
            if must_cross(c):
                cross(c)
                if not any(rem):
                    break
            step_ch = 'L' if bounce_dir == 1 else 'R'
            out.append(step_ch)
            c = (c + bounce_dir) % n
            bounce_steps += 1
            if bounce_steps >= n - 1:
                bounce_dir = -bounce_dir
                bounce_steps = 0
            continue
        if must_cross(c):
            cross(c)
            if not any(rem):
                break
        out.append(mode)
        c = (c + (1 if mode == 'L' else -1)) % n
    if any(rem):
        return None
    d = (t - c) % n
    out.append('L' * d if d <= n - d else 'R' * (n - d))
    return ''.join(out)


def price(v, word):
    n, k = len(v), sum(1 for x in v if x == 0)
    a, j = [], 0
    for x in v:
        if x:
            a.append(x)
        else:
            j += 1
            a.append(-j)
    segs, A, q, d, cz, c = [], [0] * k, 0, 0, [0] * k, 0
    for ch in word:
        if ch == 'L':
            d += 1
            if a[c] < 0:
                cz[-a[c] - 1] += 1
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            d -= 1
            if a[c] < 0:
                cz[-a[c] - 1] -= 1
        else:
            c2 = (c + 1) % n
            x, y = a[c], a[c2]
            if x < 0 and y < 0:
                return None
            q += 1
            nxt = [0] * k
            if x < 0:
                cz[-x - 1] += 1
                A[-x - 1] += 1
            elif y < 0:
                A[-y - 1] += 1
                nxt[-y - 1] = -1
            segs.append((d, cz))
            d, cz = 0, nxt
            a[c], a[c2] = y, x
    segs.append((d, cz))
    fin = a[c:] + a[:c]
    m = n - k
    if fin[:m] != list(range(1, m + 1)):
        return None
    B = q + sum(abs(s) for s, _ in segs)
    beta = [2 * A[i] + sum(abs(z[i]) for _, z in segs) for i in range(k)]
    return B, beta


def _budget(m, r):
    return m * (m + 1) // 2 + (r - 1) * (m - 2)


def _refine(v, origins):
    out, j = [], 0
    for x in v:
        if x:
            out.append(x)
        else:
            out.extend([0] * origins[j])
            j += 1
    return out


def _price_all_zeros(v, word):
    n = len(v)
    zeros = [i for i, x in enumerate(v) if x == 0]
    total_zeros = len(zeros)
    z_idx = {pos: idx for idx, pos in enumerate(zeros)}
    a = list(v)
    for idx, pos in enumerate(zeros):
        a[pos] = -1 - idx

    m = n - total_zeros
    A, q, d, cz, c = [0] * total_zeros, 0, 0, [0] * total_zeros, 0
    segs = []
    for ch in word:
        if ch == 'L':
            d += 1
            if a[c] < 0:
                cz[-1 - a[c]] += 1
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            d -= 1
            if a[c] < 0:
                cz[-1 - a[c]] -= 1
        else:
            c2 = (c + 1) % n
            x, y = a[c], a[c2]
            if x < 0 and y < 0:
                return None
            q += 1
            nxt = [0] * total_zeros
            if x < 0:
                cz[-1 - x] += 1
                A[-1 - x] += 1
            elif y < 0:
                A[-1 - y] += 1
                nxt[-1 - y] = -1
            segs.append((d, cz))
            d, cz = 0, nxt
            a[c], a[c2] = y, x
    segs.append((d, cz))
    fin = a[c:] + a[:c]
    if fin[:m] != list(range(1, m + 1)):
        return None
    B = q + sum(abs(s) for s, _ in segs)
    all_betas = [2 * A[i] + sum(abs(z[i]) for _, z in segs) for i in range(total_zeros)]
    return B, all_betas


def _sweep_words(v, deadline):
    n, m = len(v), max(v)
    r = n - m
    if r <= 4:
        perms = list(itertools.permutations(range(r)))
    else:
        perms = [[(s + i) % r for i in range(r)] for s in range(r)] + [
            [(s + r - 1 - i) % r for i in range(r)] for s in range(r)]
    words = set()
    modes = ('L', 'R', 'greedy', 'greedy_R', 'bounce_L', 'bounce_R')
    for t in range(n):
        if _time.process_time() > deadline:
            break
        for perm in perms:
            for rem in _lifts(v, t, perm, m, r):
                for c_start in (0, t) if t != 0 else (0,):
                    for mode in modes:
                        w = _sweep(v, rem, t, mode, c_start=c_start)
                        if w is not None:
                            w = _reduce(w)
                            if len(w) <= 4000:
                                words.add(w)
    return sorted(words, key=lambda w: (len(w), w))


def _pareto(priced):
    best = {}
    for w, B, beta, pick in priced:
        key = (B,) + tuple(beta)
        if key not in best or len(w) < len(best[key][0]):
            best[key] = (w, pick)
    keys = sorted(best)
    keep = []
    for x in keys:
        if not any(all(p <= q for p, q in zip(y, x)) for y in keep):
            keep.append(x)
    return [(best[x][0], x[0], list(x[1:]), best[x][1]) for x in keep]


def _simplex(A, b, c):
    rows, cols = len(A), len(c)
    T = []
    for i in range(rows):
        s = -1.0 if b[i] < 0 else 1.0
        T.append([s * x for x in A[i]] + [1.0 if r == i else 0.0 for r in range(rows)] + [s * b[i]])
    basis = list(range(cols, cols + rows))

    def pivot(r, j):
        p = T[r][j]
        inv = 1.0 / p
        T[r] = [x * inv for x in T[r]]
        for i in range(rows):
            if i != r:
                f = T[i][j]
                if abs(f) > 1e-15:
                    T[i] = [x - f * y for x, y in zip(T[i], T[r])]
        basis[r] = j

    def run(cost, allowed):
        for _ in range(2500):
            enter = None
            for j in allowed:
                if j in basis:
                    continue
                if cost[j] - sum(cost[basis[i]] * T[i][j] for i in range(rows)) < -EPS:
                    enter = j
                    break
            if enter is None:
                return True
            cand = [i for i in range(rows) if T[i][enter] > EPS]
            if not cand:
                return False
            r = min(cand, key=lambda i: (T[i][-1] / T[i][enter], basis[i]))
            pivot(r, enter)
        return False

    if not run([0.0] * cols + [1.0] * rows, range(cols + rows)):
        return None
    if sum(T[i][-1] for i in range(rows) if basis[i] >= cols) > 1e-7:
        return None
    for r in range(rows):
        if basis[r] >= cols:
            j = next((j for j in range(cols) if abs(T[r][j]) > EPS and j not in basis), None)
            if j is not None:
                pivot(r, j)
    if not run(list(c) + [0.0] * rows, range(cols)):
        return None
    x = [0.0] * cols
    for i, j in enumerate(basis):
        if j < cols:
            x[j] = T[i][-1]
    return x, sum(ci * xi for ci, xi in zip(c, x))


def _leaf_lp(cols, origins, lo, hi, s, m):
    k = len(lo)
    n = len(cols)
    bnd = [j for j in range(k) if hi[j] is not None]
    T = _budget(m, sum(lo))
    cost = [B + sum(b * (l - o) for b, l, o in zip(beta, lo, origins)) for _, B, beta, _ in cols]
    A = []
    for j in range(k):
        A.append([beta[j] for _, _, beta, _ in cols] + [-1.0 if bj == j else 0.0 for bj in bnd]
                 + [1.0 if i == j else 0.0 for i in range(k)])
    A.append([1.0] * n + [0.0] * (len(bnd) + k))
    c = cost + [hi[j] - lo[j] for j in bnd] + [0.0] * k
    out = _simplex(A, [float(s)] * k + [1.0], c)
    if out is None:
        return False, None
    x, val = out
    return val < T + 1 - 1e-6, x[:n]


def _leaf(cols, origins, weights):
    order = sorted(range(len(cols)), key=lambda i: (-weights[i], cols[i][1], i))
    chosen_words = []
    chosen_picks = None
    for i in order:
        if weights[i] > 1e-12 or len(chosen_words) < LEAF_WORDS:
            w, _, _, pick = cols[i]
            if w not in chosen_words:
                chosen_words.append(w)
                if chosen_picks is None:
                    chosen_picks = pick
            if len(chosen_words) >= LEAF_WORDS:
                break
    leaf_dict = {'words': chosen_words[:LEAF_WORDS], 'origins': list(origins)}
    if chosen_picks and any(p != 0 for p in chosen_picks):
        leaf_dict['picks'] = list(chosen_picks)
    return leaf_dict


def _get_columns(v, origins, deadline, raw_words_cache):
    ref_key = tuple(origins)
    if ref_key not in raw_words_cache:
        ref = _refine(v, origins)
        priced_raw = []
        for w in _sweep_words(ref, deadline):
            p = _price_all_zeros(ref, w)
            if p is not None:
                priced_raw.append((w, p[0], p[1]))
        raw_words_cache[ref_key] = priced_raw
    priced_raw = raw_words_cache[ref_key]

    k = len(origins)
    best_pick_rel = [0] * k
    offsets = []
    curr = 0
    for o in origins:
        offsets.append(curr)
        curr += o

    for j in range(k):
        if origins[j] > 1:
            best_rel = min(
                range(origins[j]),
                key=lambda p_rel: min((p[1][offsets[j] + p_rel] for p in priced_raw), default=9999)
            )
            best_pick_rel[j] = best_rel

    priced = []
    for w, B, all_betas in priced_raw:
        beta = [all_betas[offsets[j] + best_pick_rel[j]] for j in range(k)]
        priced.append((w, B, beta, best_pick_rel))

    return _pareto(priced)


def _staircase_on_axis(v, m, k, axis, deadline, raw_words_cache, cols_cache):
    s = m - 2
    leaves, l = [], 1
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        origins = [1] * k
        origins[axis] = min(l, MAX_ORIGIN)
        cache_key = (tuple(origins), axis)
        if cache_key not in cols_cache:
            cols_cache[cache_key] = _get_columns(v, origins, deadline, raw_words_cache)
        cols = cols_cache[cache_key]
        if not cols:
            return None
        lo = [1] * k
        lo[axis] = l
        ok, w = _leaf_lp(cols, origins, lo, [None] * k, s, m)
        if ok:
            leaves.append((_leaf(cols, origins, w), None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree
        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None
        lo_h, hi_h, best = l, MAX_CUT, None
        while lo_h <= hi_h:
            mid = (lo_h + hi_h) // 2
            hi = [None] * k
            hi[axis] = mid
            ok, w = _leaf_lp(cols, origins, lo, hi, s, m)
            if ok:
                best, lo_h = (mid, w), mid + 1
            else:
                hi_h = mid - 1
        if best is None:
            return None
        leaves.append((_leaf(cols, origins, best[1]), best[0]))
        l = best[0] + 1
    return None


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
    m = max(v)
    k = sum(1 for x in v if x == 0)
    s = m - 2

    raw_words_cache = {}
    cols_cache = {}

    unit_origins = [1] * k
    unit_cols = _get_columns(v, unit_origins, deadline, raw_words_cache)
    if unit_cols:
        ok, w = _leaf_lp(unit_cols, unit_origins, [1] * k, [None] * k, s, m)
        if ok:
            return {'tree': _leaf(unit_cols, unit_origins, w)}

    if unit_cols:
        load = [min(beta[j] for _, _, beta, _ in unit_cols) for j in range(k)]
        candidate_axes = sorted(range(k), key=lambda j: (-load[j], j))
    else:
        candidate_axes = list(range(k))

    for axis in candidate_axes:
        if _time.process_time() > deadline:
            break
        tree = _staircase_on_axis(v, m, k, axis, deadline, raw_words_cache, cols_cache)
        if tree is not None:
            return {'tree': tree}

    # 2-axis split fallback: split worst axis at cut 1..3, then staircase on 2nd axis
    if len(candidate_axes) >= 2 and _time.process_time() < deadline - 0.2:
        ax1, ax2 = candidate_axes[0], candidate_axes[1]
        for cut1 in (1, 2):
            if _time.process_time() > deadline - 0.15:
                break
            orig_le = [1] * k
            cols_le = _get_columns(v, orig_le, deadline, raw_words_cache)
            hi_le = [None] * k
            hi_le[ax1] = cut1
            ok_le, w_le = _leaf_lp(cols_le, orig_le, [1] * k, hi_le, s, m)
            if ok_le:
                node_le = _leaf(cols_le, orig_le, w_le)
                orig_ge = [1] * k
                orig_ge[ax1] = min(cut1 + 1, MAX_ORIGIN)
                cols_ge = _get_columns(v, orig_ge, deadline, raw_words_cache)
                lo_ge = [1] * k
                lo_ge[ax1] = cut1 + 1
                ok_ge, w_ge = _leaf_lp(cols_ge, orig_ge, lo_ge, [None] * k, s, m)
                if ok_ge:
                    node_ge = _leaf(cols_ge, orig_ge, w_ge)
                    return {'tree': {'j': ax1, 't': cut1, 'le': node_le, 'ge': node_ge}}

    # Fallback to best effort unit root leaf
    if unit_cols:
        order = sorted(range(len(unit_cols)), key=lambda i: (unit_cols[i][1], i))
        words = [unit_cols[i][0] for i in order[:KEEP]]
    else:
        words = []
    return {'tree': {'words': words, 'origins': unit_origins}}
