    )

    if ok_root:
        leaf = _leaf(cols_root, origins1, picks_root, w_root)
        return {'tree': leaf, 'note': 'unit root certified'}

    unit_priced = [(w, B, beta[0]) for w, B, beta in raw_cache.get(tuple(origins1), [])]
    if unit_priced:
        load = [min(beta[j] for _, _, beta in unit_priced) for j in range(k)]
        axis_order = sorted(range(k), key=lambda j: (-load[j], j))
    else:
        axis_order = list(range(k))

    for axis in axis_order:
        if _time.process_time() > deadline:
            break
        tree = _staircase(v, m, k, axis, deadline, raw_cache)
        if tree is not None:
            return {'tree': tree, 'note': 'refined staircase on axis %d' % axis}

    fallback_cols = cols_root if cols_root else _pareto_cols(
        [(w, B, beta[0]) for w, B, beta in raw_cache.get(tuple(origins1), [])]
    )
    fallback_words = [c[0] for c in fallback_cols[:KEEP]] if fallback_cols else []
    return {'tree': {'words': fallback_words, 'origins': origins1}, 'note': 'fallback root'}
