def _staircase(v, m, k, axis, deadline, cache, lo_box=None):
    s = m - 2
    leaves = []
    l = lo_box[axis] if lo_box else 1
    base_lo = list(lo_box) if lo_box else [1] * k
    while len(leaves) < MAX_STEPS and l <= MAX_CUT + 1 and _time.process_time() < deadline:
        origins = [1] * k
        origins[axis] = min(l, MAX_ORIGIN)
        lo = list(base_lo)
        lo[axis] = l
        cols, pk, ok, w = _best_cols_picks(v, origins, deadline, cache, lo, [None] * k, s, m)
        if ok:
            leaves.append((_leaf(cols, origins, pk, w), None))
            tree = leaves[-1][0]
            for node, h in reversed(leaves[:-1]):
                tree = {'j': axis, 't': h, 'le': node, 'ge': tree}
            return tree
        if len(leaves) + 1 >= MAX_STEPS or l > MAX_CUT:
            return None
        lo_h, hi_h, best = l, MAX_CUT, None
        while lo_h <= hi_h:
            mid = (lo_h + hi_h) // 2
            hi = [None] * k
            hi[axis] = mid
            c_mid, pk_mid, ok_mid, w_mid = _best_cols_picks(v, origins, deadline, cache, lo, hi, s, m)
            if ok_mid:
                best, lo_h = (mid, c_mid, pk_mid, w_mid), mid + 1
            else:
                hi_h = mid - 1
        if best is None:
            return None
        h_val, b_cols, b_pk, b_w = best
        leaves.append((_leaf(b_cols, origins, b_pk, b_w), h_val))
        l = h_val + 1
    return None


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
    m = max(v)
