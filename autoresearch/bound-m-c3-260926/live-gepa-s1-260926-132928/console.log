def _eval_leaf(v, origins, lo, hi, s, m, deadline, raw_cache, pick_cache):
    """Try different picks for origins, return (True, leaf_dict) or (False, None)."""
    k = len(origins)
    split_axes = [j for j in range(k) if origins[j] > 1]
