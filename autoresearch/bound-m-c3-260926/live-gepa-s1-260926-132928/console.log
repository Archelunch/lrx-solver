            if ok:
                best, lo_h = (mid, leaf_node), mid + 1
            else:
                hi_h = mid - 1
        if best is None:
            return None
        leaves.append((best[1], best[0]))
        l = best[0] + 1
    return None


def _build_2d_tree(v, m, k, primary_ax, sec_ax, deadline, cache):
    s = m - 2
