        best_h, best_w, best_leaf_data = None, None, None
        for pl in pick_choices:
            cols, picks = _columns_with_pick(v, origins, axis, pl, deadline, cache_raw, cache_cols)
            if not cols:
                continue
            lo_h, hi_h, cur_best = l, MAX_CUT, None
            while lo_h <= hi_h:
                mid = (lo_h + hi_h) // 2
                hi = [None] * k
                hi[axis] = mid
                ok, w = _leaf_lp(cols, origins, lo, hi, s, m)
                if ok:
                    cur_best, lo_h = (mid, w), mid + 1
                else:
                    hi_h = mid - 1
            if cur_best is not None and (best_h is None or cur_best[0] > best_h):
                best_h = cur_best[0]
                best_leaf_data = _leaf(cols, origins, cur_best[1], picks)

        if best_leaf_data is None:
            return None
        leaves.append((best_leaf_data, best_h))
        l = best_h + 1
    return None


def certify(family):
    start = _time.process_time()
    deadline = start + CPU_BUDGET
    v = family['unit_base']
    m, k = max(v), sum(1 for x in v if x == 0)

    root_out = _build_root_leaf(v)
    root = {'words': root_out['words'], 'origins': [1] * k}
    base = []
    for w in root_out['words']:
        p = price(v, w)
        if p is not None:
            base.append((w, p[0], p[1]))

    if base and _leaf_lp(base, [1] * k, [1] * k, [None] * k, m - 2, m)[0]:
        return {'tree': root, 'note': 'unit root certified'}

    cache_raw = {}
    cache_cols = {}
    unit_cols, _ = _columns_with_pick(v, [1] * k, 0, 0, deadline, cache_raw, cache_cols)
    load = [min(beta[j] for _, _, beta in unit_cols) if unit_cols else 0 for j in range(k)]

    for axis in sorted(range(k), key=lambda j: (-load[j], j)):
        if _time.process_time() > deadline:
            break
        tree = _staircase(v, m, k, axis, deadline, cache_raw, cache_cols)
        if tree is not None:
            return {'tree': tree, 'note': f'refined staircase on axis {axis}'}

    return {'tree': root, 'note': 'fallback to root leaf'}
