def _certify_root(v):
    n, m = len(v), max(v)
    k = n - m
    T = _budget(m, k)
    cols = _columns(v, [1] * k, float('inf'))
    if not cols:
        return None
    cost_vecs = [[cols[i][1] - T] + [b - (m - 2) for b in cols[i][2]] for i in range(len(cols))]
    dim = k + 1
    n_words = len(cols)
    hull = set()
    for d in range(dim):
        hull.add(min(range(n_words), key=lambda i: (cost_vecs[i][d], max(cost_vecs[i]))))
    for j in range(1, dim):
        for ratio in (0.1, 0.25, 0.5, 1.0, 2.0, 4.0, 10.0):
            hull.add(min(range(n_words), key=lambda i: cost_vecs[i][0] + ratio * cost_vecs[i][j]))
    for alpha in (1.5, 3.0):
        for s_mode in ('min_max', 'min_b'):
            cur_idx = min(range(n_words), key=lambda i: (max(cost_vecs[i]), cost_vecs[i][0]) if s_mode == 'min_max' else (cost_vecs[i][0], max(cost_vecs[i])))
            cur_vec = list(cost_vecs[cur_idx])
            hull.add(cur_idx)
            for it in range(1, 40):
                mx = max(cur_vec)
                exps = [math.exp(min(50.0, alpha * (val - mx))) for val in cur_vec]
                tot = sum(exps)
                weights = [e / tot for e in exps]
                best_i = min(range(n_words), key=lambda i: sum(weights[d] * cost_vecs[i][d] for d in range(dim)))
                hull.add(best_i)
                gamma = 2.0 / (it + 2)
                for d in range(dim):
                    cur_vec[d] = (1.0 - gamma) * cur_vec[d] + gamma * cost_vecs[best_i][d]
    ordered = sorted(hull, key=lambda i: (max(cost_vecs[i]), cost_vecs[i][0]))
    selected = [cols[i][0] for i in ordered[:KEEP]]
    return selected


