        k_val = len(selected[0]['slopes'])
        avg_slopes = [sum(c['slopes'][i] for c in selected) / m_len for i in range(k_val)]
        avg_base = sum(c['base'] for c in selected) / m_len

        best_cand = None
        best_gain = float('inf')

        for c in pool:
            new_len = m_len + 1
            new_slopes = [(avg_slopes[i] * m_len + c['slopes'][i]) / new_len for i in range(k_val)]
            new_base = (avg_base * m_len + c['base']) / new_len

            over_s = sum(max(0, s - slope_bound) for s in new_slopes)
            over_b = max(0, new_base - budget_unit)
            comb_score = over_s * 2000 + over_b * 200 + max(new_slopes) * 20 + new_base

            if comb_score < best_gain:
                best_gain = comb_score
                best_cand = c

        if best_cand:
            selected.append(best_cand)
            pool.remove(best_cand)
        else:
            break

    return {'words': [c['word'] for c in selected]}
