def lift(instance):
    rows = instance['parent']['certificate']['rows']

    # Sort rows by weight descending if available, else use row order
    # to prioritize high-influence parent certificates first
    try:
        def r_score(r):
            w = r.get('weight') or r.get('w')
            if w:
                if '/' in str(w):
                    num, den = str(w).split('/')
                    return float(num) / float(den)
                return float(w)
            return 0.0
        sorted_rows = sorted(rows, key=r_score, reverse=True)
    except Exception:
        sorted_rows = rows

    configs = [
        ('short', 'short', 0, 0),
        ('right', 'short', 0, 0),
        ('left', 'short', 0, 0),
        ('short', 'left', 0, 0),
        ('short', 'right', 0, 0),
        ('right', 'right', 0, 0),
        ('left', 'left', 0, 0),
        ('short', 'short', 1, 0),
        ('right', 'short', 1, 0),
        ('left', 'short', 1, 0),
        ('short', 'short', 0, 1),
        ('short', 'short', 0, 2),
        ('right', 'left', 0, 0),
        ('left', 'right', 0, 0),
        ('right', 'right', 1, 0),
        ('left', 'left', 1, 0),
        ('short', 'short', 2, 0),
        ('right', 'short', 2, 0),
    ]

    words = []
    seen = set()

    for direction, align_dir, pattern, head_mode in configs:
        for r in sorted_rows:
            w = gadget(instance, r['word'], direction=direction, align_dir=align_dir, pattern=pattern, head_mode=head_mode)
            if w and w not in seen:
                seen.add(w)
                words.append(w)
                if len(words) >= 16:
                    return {'words': words}

    if not words:
        for r in rows:
            w = gadget(instance, r['word'])
            if w and w not in seen:
                seen.add(w)
                words.append(w)
                if len(words) >= 16:
                    break

    return {'words': words}
