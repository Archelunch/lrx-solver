        ('short', 'short', 'short', 4, 0),
        ('short', 'short', 'short', 5, 0),
        ('short', 'short', 'short', 6, 0),
        ('short', 'short', 'short', 7, 0),
        ('short', 'short', 'short', 8, 0),
        ('short', 'short', 'short', 9, 0),
        ('short', 'right', 'short', 1, 0),
        ('short', 'left', 'short', 1, 0),
        ('short', 'right', 'short', 2, 0),
        ('short', 'left', 'short', 2, 0),
        ('short', 'right', 'short', 3, 0),
        ('short', 'left', 'short', 3, 0),
        ('short', 'right', 'short', 4, 0),
        ('short', 'left', 'short', 4, 0),
        ('short', 'short', 'short', 0, 1),
        ('short', 'short', 'short', 0, 2),
        ('short', 'short', 'short', 0, 3),
        ('short', 'short', 'short', 0, 4),
        ('short', 'right', 'short', 0, 1),
        ('short', 'left', 'short', 0, 1),
        ('short', 'short', 'short', 1, 1),
        ('short', 'short', 'short', 2, 2),
        ('short', 'short', 'short', 3, 3),
        ('L', 'short', 'R', 1, 0),
        ('R', 'short', 'L', 1, 0),
        ('L', 'short', 'R', 0, 1),
        ('R', 'short', 'L', 0, 1),
        ('L', 'right', 'short', 2, 1),
        ('R', 'left', 'short', 3, 2),
    ]

    parent_cand_map = {idx: [] for idx in range(len(rows))}
    for r_idx, r in enumerate(rows):
        pword = r['word']
        for head_mode, move_mode, align_mode, pat, zpat in configs:
            cand = _build_gadget(
                instance, pword, head_mode, move_mode, align_mode, pat, z_pat=zpat
            )
            if cand:
                if cand not in cand_dict:
                    blen, slopes = _eval_slopes_and_base(child, cand)
                    cand_dict[cand] = (blen, slopes)
                parent_cand_map[r_idx].append(cand)

    cands = []
    for w, (blen, slopes) in cand_dict.items():
        max_s = max(slopes) if slopes else 0
        sum_s = sum(slopes)
        over_slope = sum(max(0, s - slope_bound) for s in slopes)
        over_base = max(0, blen - budget_unit)
        single_score = (
            over_slope * 2500
            + over_base * 200
            + max_s * 30
            + blen
            + sum_s * 0.2
        )
        cands.append(
            {'word': w, 'base': blen, 'slopes': slopes, 'score': single_score}
        )

    cands.sort(key=lambda x: x['score'])
    if not cands:
        return {'words': []}

    cand_by_word = {c['word']: c for c in cands}

    # Track parent rows sorted by weight descending
    p_weights = [Fraction(r.get('weight', r.get('w', '1'))) for r in rows]
    sorted_p_indices = sorted(range(len(rows)), key=lambda i: p_weights[i], reverse=True)

    selected_words = []
    # Pick the top-scoring candidate for each parent row
    for r_idx in sorted_p_indices:
        p_cands = parent_cand_map[r_idx]
        if p_cands:
            best_p = min(p_cands, key=lambda w: cand_by_word[w]['score'])
            if best_p not in selected_words:
                selected_words.append(best_p)

    # For parent rows with substantial weight, offer alternative slope profiles
    for r_idx in sorted_p_indices:
        if len(selected_words) >= 14:
            break
        p_cands = parent_cand_map[r_idx]
        if len(p_cands) > 1:
            # find an alternative that minimizes maximum slope
            alt_cands = [w for w in p_cands if w not in selected_words]
            if alt_cands:
                alt = min(alt_cands, key=lambda w: (max(cand_by_word[w]['slopes']), cand_by_word[w]['base']))
                selected_words.append(alt)

    selected = [cand_by_word[w] for w in selected_words[:16]]
    selected_set = {c['word'] for c in selected}
    pool = [c for c in cands if c['word'] not in selected_set]

    # Greedy selection targeting bottleneck slopes and base overshoots
    while len(selected) < 16 and pool:
        m_len = len(selected)
        k_val = len(selected[0]['slopes'])
        avg_slopes = [
            sum(c['slopes'][i] for c in selected) / m_len for i in range(k_val)
        ]
        avg_base = sum(c['base'] for c in selected) / m_len

        best_cand = None
        best_gain = float('inf')

        for c in pool:
            new_len = m_len + 1
            new_slopes = [
                (avg_slopes[i] * m_len + c['slopes'][i]) / new_len
                for i in range(k_val)
            ]
            new_base = (avg_base * m_len + c['base']) / new_len

            over_s = sum(max(0, s - slope_bound) for s in new_slopes)
            over_b = max(0, new_base - budget_unit)
            comb_score = (
                over_s * 6000
                + over_b * 400
                + max(new_slopes) * 50
                + new_base
            )

            if comb_score < best_gain:
                best_gain = comb_score
                best_cand = c

        if best_cand:
            selected.append(best_cand)
            pool.remove(best_cand)
        else:
            break

    return {'words': [c['word'] for c in selected]}
