    # Net absolute or L/R passes experienced by each zero block.
    # We can trace positions of elements and count rotations
    pos = list(range(n))
    inv = list(range(n))
    c = 0
    # Track passes through index 0
    net_rot = [0] * num_blocks
    zero_blocks = [block_map.get(i, -1) for i in range(n)]

    # Exact Lemma 1 cost: len(word)
    base_cost = len(word)

    for ch in word:
        if ch == 'L':
            # c moves left / array rotates left
            b = zero_blocks[pos[c]]
            if b >= 0:
                net_rot[b] += 1
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            b = zero_blocks[pos[c]]
            if b >= 0:
                net_rot[b] += 1
