def _reduce(word):
    out = []
    for ch in word:
        if out and out[-1] + ch in ('LR', 'RL'):
            out.pop()
        elif len(out) >= 1 and ch == 'X' and out[-1] == 'X':
            out.pop()
        else:
            out.append(ch)
    return ''.join(out)


def _eval_slopes_and_base(unit_base, word):
    n = len(unit_base)
    zero_pos = [i for i, x in enumerate(unit_base) if x == 0]
    k = len(zero_pos)
    base_len = len(word)
    slopes = [0] * k
    for idx, p in enumerate(zero_pos):
