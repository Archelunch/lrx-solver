                counts[top] += 1
            s = s[1:] + s[:1]
        elif ch == 'R':
            # right rotation: last slot moves to 0
            s = s[-1:] + s[:-1]
            top = s[0]
            if top is not None:
                counts[top] += 1
        else: # 'X'
            # swap 0 and 1
            s[0], s[1] = s[1], s[0]
            if s[0] is not None:
