            elif a[c2] == tz:
                out.append('XLXR')
            else:
                out.append('X')
            a[c], a[c2] = a[c2], a[c]
    st, zi = [], 0
    for x in state:
        if x:
            st.append(x)
        else:
            st.extend([0, 0] if zi == target else [0])
            zi += 1
    return st, ''.join(out)


def _pair_word(state, word, m, pattern=0):
    """Replay word on state with label m replaced by the pair (m, m+1)."""
    a, n, c, out = list(state), len(state), 0, []
    if pattern == 0:
        t1, t2 = 'LXRX', 'XLXR'
    elif pattern == 1:
        t1, t2 = 'XLXR', 'LXRX'
    elif pattern == 2:
        t1, t2 = 'RXXL', 'XRXR'
    elif pattern == 3:
        t1, t2 = 'XRXR', 'RXXL'
    elif pattern == 4:
        t1, t2 = 'XRXL', 'LXLR'
    elif pattern == 5:
        t1, t2 = 'LXLR', 'XRXL'
    else:
        t1, t2 = 'LXRX', 'XLXR'

    for ch in word:
        if ch == 'L':
            out.append('LL' if a[c] == m else 'L')
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            out.append('RR' if a[c] == m else 'R')
        else:
            c2 = (c + 1) % n
            out.append(t1 if a[c] == m else t2 if a[c2] == m else 'X')
            a[c], a[c2] = a[c2], a[c]
    return ''.join(out)


def compute_exact_slopes(child_base, word):
    """Compute exact base length and slope for each zero block on child_base."""
    # Label zero blocks distinctly: -1, -2, ..., -k
    a = []
    zi = 0
    for x in child_base:
        if x == 0:
            zi += 1
            a.append(-zi)
        else:
            a.append(x)
    k = zi
    n = len(a)
    c = 0
    # count letters contributed by each zero block
    # When zero block tz is touched by L/R/X:
    # L on tz adds 2 instead of 1 -> 1 extra
    # R on tz adds 2 instead of 1 -> 1 extra
    # X on tz or next tz adds (len(t) - 1) extra
    # Instead, we directly measure how length scales if each zero block is expanded by 1 zero.
    # By Lemma 1: expanding block z by 1 zero replaces letters as in _lifted.
    # The slope for block z is exactly len(lifted(child_base, word, block_z)) - len(word).
    # We can evaluate this efficiently:
    # Under lift of block z:
    # Each L on z adds 1 to length
    # Each R on z adds 1 to length
    # Each X with z at c or (c+1)%n adds (4 - 1) = 3 to length
    slope = [0] * k
    for ch in word:
        if ch == 'L':
            pos = a[c]
            if pos < 0:
                slope[-pos - 1] += 1
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            pos = a[c]
            if pos < 0:
                slope[-pos - 1] += 1
        else:
            c2 = (c + 1) % n
            p1, p2 = a[c], a[c2]
            if p1 < 0:
                slope[-p1 - 1] += 3
            elif p2 < 0:
                slope[-p2 - 1] += 3
            a[c], a[c2] = a[c2], a[c]

    return len(word), slope


def gadget(instance, parent_word, direction='short', align_dir='short', pattern=0, head_mode=0):
    m = instance['m']
    child = instance['child']['unit_base']
    n = len(child)
    pos, split = instance['insert']['position'], instance['insert']['split']
    p = child.index(m + 1)

    if head_mode == 0:
        if align_dir == 'left':
            head = 'L' * p
        elif align_dir == 'right':
            head = 'R' * ((n - p) % n)
        else:
            head = 'L' * p if p <= n - p else 'R' * (n - p)
    elif head_mode == 1:
        head = 'L' * p
    elif head_mode == 2:
        head = 'R' * ((n - p) % n)
    elif head_mode == 3:
        pm = child.index(m)
        head = 'L' * pm if pm <= n - pm else 'R' * (n - pm)
    else:
        head = 'L' * p

    v = _rot(child, head)
    if head_mode == 3:
        q = v.index(m + 1)
    else:
        q = v.index(m)
    right = q <= n - 1 - q if direction == 'short' else (direction == 'right')
    move = 'XL' * q if right else 'RX' * (n - 1 - q)

    v = _rot(v, move)

    base, word = _lifted(instance['parent']['unit_base'], parent_word, pos if split == 'both' else None)
    pair = []
    for x in base:
        pair.extend([m, m + 1] if x == m else [x])
    shifts = [s for s in range(n) if v[s:] + v[:s] == pair]
    if not shifts:
        return None
    s = shifts[0]

    if align_dir == 'left':
        align = 'L' * s
    elif align_dir == 'right':
        align = 'R' * ((n - s) % n)
    else:
        align = 'L' * s if s <= n - s else 'R' * (n - s)

    pw = _pair_word(base, word, m, pattern=pattern)
    cand = _reduce(head + move + align + pw)

    if len(cand) > 4000:
        return None

    target = list(range(1, m + 2)) + [0] * (n - (m + 1))
    if _rot(child, cand) == target:
        return cand
    return None


def lift(instance):
    rows = instance['parent']['certificate']['rows']
    child_base = instance['child']['unit_base']
    k = instance['child']['k']
    budget_unit = instance['child']['budget_unit']

    def r_weight(r):
        w = r.get('weight') or r.get('w')
        if w:
            if '/' in str(w):
                num, den = str(w).split('/')
                return float(num) / float(den)
            return float(w)
        return 0.0

    # Sort rows by parent weight descending
    sorted_rows = sorted(enumerate(rows), key=lambda x: r_weight(x[1]), reverse=True)

    configs = [
        ('short', 'short', 0, 0),
        ('short', 'short', 1, 0),
        ('right', 'short', 0, 0),
        ('left', 'short', 0, 0),
        ('short', 'left', 0, 0),
        ('short', 'right', 0, 0),
        ('right', 'right', 0, 0),
        ('left', 'left', 0, 0),
        ('short', 'short', 2, 0),
        ('short', 'short', 3, 0),
        ('short', 'short', 4, 0),
        ('short', 'short', 5, 0),
        ('right', 'short', 1, 0),
        ('left', 'short', 1, 0),
        ('short', 'short', 0, 1),
        ('short', 'short', 0, 2),
        ('short', 'short', 0, 3),
        ('right', 'right', 1, 0),
        ('left', 'left', 1, 0),
        ('right', 'left', 0, 0),
        ('left', 'right', 0, 0),
        ('right', 'short', 2, 0),
        ('left', 'short', 2, 0),
        ('right', 'short', 3, 0),
        ('short', 'left', 1, 0),
        ('short', 'right', 1, 0),
    ]

    candidates_by_row = {}
    seen = set()

    for orig_idx, r in sorted_rows:
        p_word = r['word']
        row_cands = []
        for cfg in configs:
            direction, align_dir, pattern, head_mode = cfg
            cand = gadget(instance, p_word, direction=direction, align_dir=align_dir,
                          pattern=pattern, head_mode=head_mode)
            if cand and cand not in seen:
                seen.add(cand)
                cost, slopes = compute_exact_slopes(child_base, cand)
                # Penalty: base overshoot + sum of slopes exceeding 7
                base_pen = max(0, cost - budget_unit)
                slope_pen = sum(max(0, s - 7) for s in slopes)
                max_s = max(slopes) if slopes else 0
                score = (slope_pen, base_pen, max_s, cost)
                row_cands.append((score, cost, slopes, cand))

        if row_cands:
            row_cands.sort(key=lambda x: x[0])
            candidates_by_row[orig_idx] = row_cands

    if not candidates_by_row:
        return {'words': []}

    # Selection strategy:
    # 1. Take the best scoring candidate from each active parent row
    # 2. Pick additional low-penalty candidates to provide the LP solver
    #    with multiple slope-tradeoff options for the high-weight parent rows
    selected = []
    selected_set = set()

    # Step 1: Ensure each available parent row has its top word
    for orig_idx, r in sorted_rows:
        if orig_idx in candidates_by_row and candidates_by_row[orig_idx]:
            best = candidates_by_row[orig_idx][0][3]
            if best not in selected_set:
                selected_set.add(best)
                selected.append(best)

    # Step 2: Add alternative configurations with varied slope profiles from high-weight rows
    round_idx = 1
    while len(selected) < 16:
        added = False
        for orig_idx, r in sorted_rows:
            if orig_idx in candidates_by_row:
                cands = candidates_by_row[orig_idx]
                if round_idx < len(cands):
                    w = cands[round_idx][3]
                    if w not in selected_set:
                        selected_set.add(w)
                        selected.append(w)
                        added = True
                        if len(selected) >= 16:
                            break
        round_idx += 1
        if not added:
            break

    # Step 3: Fill remaining slots with global lowest-penalty words
    if len(selected) < 16:
        all_remaining = []
        for orig_idx in candidates_by_row:
            for item in candidates_by_row[orig_idx]:
                if item[3] not in selected_set:
                    all_remaining.append(item)
        all_remaining.sort(key=lambda x: x[0])
        for item in all_remaining:
            w = item[3]
            if w not in selected_set:
                selected_set.add(w)
                selected.append(w)
                if len(selected) >= 16:
                    break

    return {'words': selected[:16]}
