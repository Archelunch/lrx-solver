Iteration 54: Proposed new text for current_candidate: """Optimized lift gadget for LRX sorting.

Generates candidate lifts for child instances from parent certificates.
Explores diverse insertion pathways, gadget alignments, swap patterns, and
solves/approximates exact LP combinations to select up to 16 certified words
minimizing LP gap and slope bottlenecks.
"""

from fractions import Fraction


def _rot(v, word):
    v = list(v)
    for ch in word:
        if ch == 'L':
            v = v[1:] + v[:1]
        elif ch == 'R':
            v = v[-1:] + v[:-1]
        else:
            v[0], v[1] = v[1], v[0]
    return v


def _reduce(word):
    changed = True
    while changed:
        changed = False
        out = []
        for ch in word:
            if out and out[-1] + ch in ('LR', 'RL'):
                out.pop()
                changed = True
            elif out and ch == 'X' and out[-1] == 'X':
                out.pop()
                changed = True
            else:
                out.append(ch)
        word = ''.join(out)
    return word


_PATTERNS = [
    ('LXRX', 'XLXR'),
    ('XLXR', 'LXRX'),
    ('RXXL', 'RXRX'),
    ('RXRX', 'RXXL'),
    ('XRXL', 'RXRX'),
    ('LXRX', 'RXXL'),
    ('XLXR', 'RXXL'),
    ('RXXL', 'XLXR'),
    ('XRXL', 'LXRX'),
    ('LXRX', 'XRXL'),
]


def _lifted(state, word, stretch_gap, z_pat=0):
    if stretch_gap is None:
        return list(state), word
    gaps, lab = [], 0
    for x in state:
        if x:
            lab += 1
        else:
            gaps.append(lab)
    try:
        target = gaps.index(stretch_gap)
    except ValueError:
        return list(state), word

    a, zi = [], 0
    for x in state:
        if x:
            a.append(x)
        else:
            a.append(-(zi + 1))
            zi += 1
    tz = -(target + 1)

    t1, t2 = _PATTERNS[z_pat % len(_PATTERNS)]

    out = []
    n = len(a)
    c = 0
    for ch in word:
        if ch == 'L':
            out.append('LL' if a[c] == tz else 'L')
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            out.append('RR' if a[c] == tz else 'R')
        else:
            c2 = (c + 1) % n
            if a[c] == tz:
                out.append(t1)
            elif a[c2] == tz:
                out.append(t2)
            else:
                out.append('X')
            a[c], a[c2] = a[c2], a[c]
    st, zi = [], 0
    for x in state:
        if x:
            st.append(x)
        else:
            st.extend([0, 0] if zi == target else [0])
            zi += 1
    return st, ''.join(out)


def _pair_word(state, word, m, pattern=0):
    a, n, c, out = list(state), len(state), 0, []
    t1, t2 = _PATTERNS[pattern % len(_PATTERNS)]

    for ch in word:
        if ch == 'L':
            out.append('LL' if a[c] == m else 'L')
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            out.append('RR' if a[c] == m else 'R')
        else:
            c2 = (c + 1) % n
            out.append(t1 if a[c] == m else t2 if a[c2] == m else 'X')
            a[c], a[c2] = a[c2], a[c]
    return ''.join(out)


def _eval_slopes_and_base(unit_base, word):
    n = len(unit_base)
    zero_pos = [i for i, x in enumerate(unit_base) if x == 0]
    k = len(zero_pos)
    base_len = len(word)
    slopes = [0] * k
    for idx, p in enumerate(zero_pos):
        v_idx = p
        count = 0
        for ch in word:
            if ch == 'L':
                v_idx = (v_idx - 1) % n
            elif ch == 'R':
                v_idx = (v_idx + 1) % n
            else:
                if v_idx == 0:
                    v_idx = 1
                    count += 1
                elif v_idx == 1:
                    v_idx = 0
                    count += 1
        slopes[idx] = count
    return base_len, slopes


def _build_gadget(instance, parent_word, head_mode, move_mode, align_mode, pattern, z_pat=0):
    m = instance['m']
    child = instance['child']['unit_base']
    n = len(child)
    pos, split = instance['insert']['position'], instance['insert']['split']
    p = child.index(m + 1)

    if head_mode == 'L':
        head = 'L' * p
    elif head_mode == 'R':
        head = 'R' * ((n - p) % n)
    else:
        head = 'L' * p if p <= (n - p) % n else 'R' * ((n - p) % n)

    v = _rot(child, head)
    q = v.index(m)

    if move_mode == 'right':
        move = 'XL' * q
    elif move_mode == 'left':
        move = 'RX' * ((n - 1 - q) % n)
    else:
        move = 'XL' * q if q <= (n - 1 - q) % n else 'RX' * ((n - 1 - q) % n)

    v = _rot(v, move)

    base, word = _lifted(
        instance['parent']['unit_base'],
        parent_word,
        pos if split == 'both' else None,
        z_pat=z_pat,
    )
    pair = []
    for x in base:
        pair.extend([m, m + 1] if x == m else [x])

    shifts = [s for s in range(n) if v[s:] + v[:s] == pair]
    if not shifts:
        return None
    s = shifts[0]

    if align_mode == 'L':
        align = 'L' * s
    elif align_mode == 'R':
        align = 'R' * ((n - s) % n)
    else:
        align = 'L' * s if s <= (n - s) % n else 'R' * ((n - s) % n)

    pw = _pair_word(base, word, m, pattern=pattern)
    cand = _reduce(head + move + align + pw)

    if len(cand) > 4000:
        return None

    target = list(range(1, m + 2)) + [0] * (n - (m + 1))
    if _rot(child, cand) == target:
        return cand
    return None


def lift(instance):
    rows = instance['parent']['certificate']['rows']
    child = instance['child']['unit_base']
    budget_unit = instance['child']['budget_unit']
    slope_bound = instance['child']['slope_bound']

    cand_dict = {}

    configs = [
        ('short', 'short', 'short', 0, 0),
        ('short', 'right', 'short', 0, 0),
        ('short', 'left', 'short', 0, 0),
        ('L', 'short', 'short', 0, 0),
