def _lifted(state, word, stretch_gap):
    """Lemma 1 lift of word on the unit base with one extra zero in block `stretch_gap`."""
    if stretch_gap is None:
        return list(state), word
    gaps, lab = [], 0
    for x in state:
        if x:
            lab += 1
        else:
            gaps.append(lab)
    target = gaps.index(stretch_gap)
    a, zi = [], 0
    for x in state:
        if x:
            a.append(x)
        else:
            a.append(-(zi + 1))
            zi += 1
    tz = -(target + 1)
    out = []
    n = len(a)
    c = 0
    for ch in word:
        if ch == 'L':
            out.append('LL' if a[c] == tz else 'L')
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            out.append('RR' if a[c] == tz else 'R')
        else:
            c2 = (c + 1) % n
            if a[c] == tz:
                out.append('LXRX')
            elif a[c2] == tz:
                out.append('XLXR')
            else:
                out.append('X')
            a[c], a[c2] = a[c2], a[c]
    st, zi = [], 0
    for x in state:
        if x:
            st.append(x)
        else:
            st.extend([0, 0] if zi == target else [0])
            zi += 1
    return st, ''.join(out)


def _pair_word(state, word, m, pattern=0):
    """Replay word on state with label m replaced by the pair (m, m+1)."""
    a, n, c, out = list(state), len(state), 0, []
    # Patterns for swapping / passing through paired adjacent elements
    patterns = [
        ('LXRX', 'XLXR'),
        ('RXXL', 'RXRX'),
        ('XLXR', 'LXRX'),
        ('RXRX', 'RXXL'),
        ('LXRRXL', 'RXXLLR'),
        ('XLLXRR', 'LLXRXR'),
        ('RRXLLX', 'XRXLLR'),
        ('RXLX', 'LXRX'),
        ('LXRX', 'RXLX'),
        ('XRXL', 'LXXR'),
        ('LXXR', 'XRXL'),
    ]
    t1, t2 = patterns[pattern % len(patterns)]

    for ch in word:
        if ch == 'L':
            out.append('LL' if a[c] == m else 'L')
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            out.append('RR' if a[c] == m else 'R')
        else:
            c2 = (c + 1) % n
            out.append(t1 if a[c] == m else t2 if a[c2] == m else 'X')
            a[c], a[c2] = a[c2], a[c]
    return ''.join(out)


def _reduce(word):
