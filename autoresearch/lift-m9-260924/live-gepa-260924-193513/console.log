        m_slopes = [sum(w[i] * cols[i][1][j] for j in range(k_slopes)) for j in range(k_slopes)]

        gap_base = (m_base - budget_unit)
        gap_slopes = [m_slopes[j] - slope_bound for j in range(k_slopes)]

        max_g = gap_base
        worst_type = -1  # -1 for base, j for slope j
        for j, gs in enumerate(gap_slopes):
            if gs > max_g:
                max_g = gs
                worst_type = j

        if max_g < best_gap:
            best_gap = max_g
            best_w = list(w)
            if best_gap <= 0:
                break

        # Subgradient update
        if worst_type == -1:
            grad = [cols[i][0] for i in range(K)]
        else:
            grad = [cols[i][1][worst_type] for i in range(K)]

        # Move w in negative gradient direction on simplex (mirror descent / exponentiated gradient)
        # Using simple exponentiated gradient:
        eta = lr / (1.0 + step * 0.05)
        # normalize grad
        g_min = min(grad)
        g_max = max(grad)
        denom = (g_max - g_min) if g_max > g_min else 1.0
        norm_g = [(g - g_min) / denom for g in grad]

        w_new = [w[i] * (2.718281828459045 ** (-eta * norm_g[i])) for i in range(K)]
        s_w = sum(w_new)
        w = [wi / s_w for wi in w_new]

    return best_gap, best_w


