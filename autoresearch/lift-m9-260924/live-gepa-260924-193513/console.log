        head = 'R' * ((n - p) % n)
    else:
        head = 'L' * p if p <= n - p else 'R' * (n - p)

    v = _rot(child, head)
    q = v.index(m)

    if direction == 'short':
        right = q <= n - 1 - q
    elif direction == 'right':
        right = True
    elif direction == 'left':
        right = False
    else:
        right = True

    move = 'XL' * q if right else 'RX' * (n - 1 - q)
    v = _rot(v, move)

    base, word = _lifted(instance['parent']['unit_base'], parent_word, pos if split == 'both' else None)
    pair = []
    for x in base:
        pair.extend([m, m + 1] if x == m else [x])
    shifts = [s for s in range(n) if v[s:] + v[:s] == pair]
    if not shifts:
        return None
    s = shifts[0]

    if align_dir == 'left':
        align = 'L' * s
    elif align_dir == 'right':
        align = 'R' * ((n - s) % n)
    else:
        align = 'L' * s if s <= n - s else 'R' * (n - s)

    pw = _pair_word(base, word, m, pattern=pattern)
    cand = _reduce(head + move + align + pw)

    target = list(range(1, m + 2)) + [0] * (n - (m + 1))
    if _rot(child, cand) == target:
        return cand
    return None


def _solve_approx_lp(candidates, budget_unit, slope_bound):
    """Simple Frank-Wolfe / Multiplicative Weights to find optimal LP mixture gap."""
    if not candidates:
        return 999.0, []
    k_dim = len(candidates[0][1])
    # normalized constraints: base / budget_unit <= 1, slope_j / slope_bound <= 1
    # We want min max(base/budget, max_j slope_j/slope_bound)
    N = len(candidates)
    weights = [1.0 / N] * N
    
    # 35 iterations of projected subgradient / mirror descent
    for _ in range(35):
        # compute current mixture
        m_base = sum(weights[i] * candidates[i][0] for i in range(N))
        m_slopes = [sum(weights[i] * candidates[i][1][j] for i in range(N)) for j in range(k_dim)]
        
        # constraint violations
        vals = [m_base / budget_unit] + [s / slope_bound for s in m_slopes]
        max_v = max(vals)
        max_idx = vals.index(max_v)
        
        # find candidate that minimizes the worst constraint
        if max_idx == 0:
            best_c = min(range(N), key=lambda i: candidates[i][0])
        else:
            s_idx = max_idx - 1
            best_c = min(range(N), key=lambda i: candidates[i][1][s_idx])
            
        lr = 2.0 / (_ + 3)
        for i in range(N):
            weights[i] = (1.0 - lr) * weights[i] + (lr if i == best_c else 0.0)

    m_base = sum(weights[i] * candidates[i][0] for i in range(N))
    m_slopes = [sum(weights[i] * candidates[i][1][j] for i in range(N)) for j in range(k_dim)]
    gap = max(0.0, m_base / budget_unit - 1.0, *(s / slope_bound - 1.0 for s in m_slopes))
    return gap, weights


def lift(instance):
    rows = instance['parent']['certificate']['rows']
    child = instance['child']['unit_base']
    k_val = instance['child'].get('k', 4)
    budget_unit = instance['child'].get('budget_unit', 39 + 7 * k_val)
    slope_bound = instance['child'].get('slope_bound', 7)

    configs = [
        ('short', 'short', 'short', 0),
        ('right', 'short', 'short', 0),
        ('left', 'short', 'short', 0),
        ('short', 'left', 'short', 0),
        ('short', 'right', 'short', 0),
        ('right', 'right', 'short', 0),
        ('left', 'left', 'short', 0),
        ('short', 'short', 'left', 0),
        ('short', 'short', 'right', 0),
        ('right', 'right', 'right', 0),
        ('left', 'left', 'left', 0),
        ('short', 'short', 'short', 1),
        ('right', 'short', 'short', 1),
        ('left', 'short', 'short', 1),
        ('short', 'left', 'short', 1),
        ('short', 'right', 'short', 1),
        ('short', 'short', 'short', 2),
        ('right', 'short', 'short', 2),
        ('left', 'short', 'short', 2),
        ('short', 'short', 'short', 3),
        ('right', 'short', 'short', 3),
        ('left', 'short', 'short', 3),
    ]

    by_row = {i: [] for i in range(len(rows))}
    seen_words = set()
    all_valid = []

    for r_idx, r in enumerate(rows):
        for direction, align_dir, head_dir, pat in configs:
            w = gadget(instance, r['word'], direction=direction, align_dir=align_dir, head_dir=head_dir, pattern=pat)
            if w and w not in seen_words and len(w) <= 4000:
                seen_words.add(w)
                blen, slopes = _eval_slopes_and_base(child, w)
                item = (blen, slopes, w, r_idx)
                by_row[r_idx].append(item)
                all_valid.append(item)

    # Sort candidates per row by max slope overshoot then base
    for r_idx in by_row:
        by_row[r_idx].sort(key=lambda item: (
            max(0, max(item[1]) - slope_bound) if item[1] else 0,
            max(item[1]) if item[1] else 0,
            item[0]
        ))

    # Initial selection: ensure representation across parent rows
    chosen_items = []
    chosen_words = set()

    for pass_idx in range(4):
        for r_idx in range(len(rows)):
            if len(chosen_items) >= 16:
                break
            if pass_idx < len(by_row[r_idx]):
                item = by_row[r_idx][pass_idx]
                if item[2] not in chosen_words:
                    chosen_words.add(item[2])
                    chosen_items.append(item)

    # Greedy exchange / expansion using approximate LP solver
    # Pool of unchosen candidates
    pool = [item for item in all_valid if item[2] not in chosen_words]
    pool.sort(key=lambda item: (
        max(0, max(item[1]) - slope_bound) if item[1] else 0,
        sum(item[1]),
        item[0]
    ))

    # Fill up to 16 if needed
    for item in pool:
        if len(chosen_items) >= 16:
            break
        chosen_words.add(item[2])
        chosen_items.append(item)

    # Now attempt greedy swaps to improve LP gap
    if len(chosen_items) > 1 and pool:
        best_gap, _ = _solve_approx_lp(chosen_items, budget_unit, slope_bound)
        # Check top candidates from pool for beneficial swaps
        for cand in pool[:30]:
            if cand[2] in chosen_words:
                continue
            best_swap_idx = -1
            best_swap_gap = best_gap
            for i in range(len(chosen_items)):
                trial = list(chosen_items)
                trial[i] = cand
                g, _ = _solve_approx_lp(trial, budget_unit, slope_bound)
                if g < best_swap_gap - 1e-4:
                    best_swap_gap = g
                    best_swap_idx = i
            if best_swap_idx != -1:
                chosen_words.remove(chosen_items[best_swap_idx][2])
                chosen_items[best_swap_idx] = cand
                chosen_words.add(cand[2])
                best_gap = best_swap_gap

    return {'words': [item[2] for item in chosen_items]}
