    """
    K = len(cols[0][1])
    N = len(cols)
    if N == 0:
        return 999.0, []

    w = [1.0 / N] * N
    # Fast Frank-Wolfe iterations
    for _ in range(35):
        # compute violations for current w
        curr_base = sum(w[j] * cols[j][0] for j in range(N))
        base_viol = curr_base - budget_unit
        max_viol = base_viol
        crit_type = -1  # -1 for base, >=0 for slope
        for i in range(K):
            curr_sl = sum(w[j] * cols[j][1][i] for j in range(N))
            v = curr_sl - slope_bound
            if v > max_viol:
                max_viol = v
                crit_type = i

        # gradient direction: find column j minimizing that critical violation
        if crit_type == -1:
            best_j = min(range(N), key=lambda j: cols[j][0])
        else:
            best_j = min(range(N), key=lambda j: cols[j][1][crit_type])

        step = 2.0 / (_ + 2)
        for j in range(N):
            w[j] = (1.0 - step) * w[j] + (step if j == best_j else 0.0)

    # Evaluate final violation
    curr_base = sum(w[j] * cols[j][0] for j in range(N))
    viol = max([curr_base - budget_unit] + [sum(w[j] * cols[j][1][i] for j in range(N)) - slope_bound for i in range(K)])
    return viol, w


