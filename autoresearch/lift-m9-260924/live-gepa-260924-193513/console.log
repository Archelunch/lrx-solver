    # Second: for the top weighted parent rows, add alternative slope profiles (e.g. min max_slope vs min cost)
    for orig_r_idx, r in sorted_rows:
        if orig_r_idx in by_row:
            # Sort by min max_slope
            by_slope = sorted(by_row[orig_r_idx], key=lambda x: (x['max_slope'], x['cost']))
            for c in by_slope:
                if c['word'] not in selected_set:
                    selected_set.add(c['word'])
                    selected.append(c['word'])
                    break
        if len(selected) >= 16:
