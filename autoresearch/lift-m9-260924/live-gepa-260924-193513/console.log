def _compute_slopes(child_base, word):
    """
    Computes exact Lemma 1 base cost and slopes per zero block.
    A unit base has nonzero labels and zeros marking zero blocks.
    A zero block is identified by its index among zero entries.
    Slopes track how many times zero entries are manipulated/crossed.
    In the trusted evaluator:
      base cost = reduced word length
      slopes: tracking actions incident to each zero block.
    """
    base_cost = len(word)
    # Track zeros:
    zeros = [i for i, x in enumerate(child_base) if x == 0]
    k = len(zeros)
    if k == 0:
        return base_cost, []
    
    # Simulate tracking which initial zero position occupies which slot
    n = len(child_base)
    # tag 0s with 0..k-1, others with None
    slot = [None] * n
    z_idx = 0
    for i, x in enumerate(child_base):
