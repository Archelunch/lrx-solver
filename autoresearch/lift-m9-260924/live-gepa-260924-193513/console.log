        cands_by_row[r_idx].sort(key=lambda item: (item[0], item[1], item[2]))

    # Selection: guarantee diversity across parent rows while prioritizing low score/slopes
    selected = []
    selected_set = set()

    # First, take the top candidates from each parent row round-robin
    max_per_row = max((len(c) for c in cands_by_row), default=0)
