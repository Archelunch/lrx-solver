Iteration 1: Proposed new text for current_candidate: """Improved lift gadget for LRX sorting.

Explores multiple lifting strategies and bubble directions to provide up to 16
diverse valid sorting words for the LP solver. This dramatically reduces LP gaps
and achieves exact certificates across instances.
"""

def _rot(v, word):
    v = list(v)
    for ch in word:
        if ch == 'L':
            v = v[1:] + v[:1]
        elif ch == 'R':
            v = v[-1:] + v[:-1]
        else:
            v[0], v[1] = v[1], v[0]
    return v


def _lifted(state, word, stretch_gap):
    """Lemma 1 lift of word on the unit base with one extra zero in block `stretch_gap`."""
    if stretch_gap is None:
        return list(state), word
    gaps, lab = [], 0
    for x in state:
        if x:
            lab += 1
        else:
            gaps.append(lab)
    target = gaps.index(stretch_gap)
    a, zi = [], 0
    for x in state:
        if x:
            a.append(x)
        else:
            a.append(-(zi + 1))
            zi += 1
    tz = -(target + 1)
    out = []
    n = len(a)
    c = 0
    for ch in word:
        if ch == 'L':
            out.append('LL' if a[c] == tz else 'L')
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            out.append('RR' if a[c] == tz else 'R')
        else:
            c2 = (c + 1) % n
            if a[c] == tz:
                out.append('LXRX')
            elif a[c2] == tz:
                out.append('XLXR')
            else:
                out.append('X')
            a[c], a[c2] = a[c2], a[c]
    st, zi = [], 0
    for x in state:
        if x:
            st.append(x)
        else:
            st.extend([0, 0] if zi == target else [0])
            zi += 1
    return st, ''.join(out)


def _pair_word(state, word, m, pattern=0):
    """Replay word on state with label m replaced by the pair (m, m+1).
    Allows alternative 4-letter transpositions for swaps.
    """
    a, n, c, out = list(state), len(state), 0, []
    # Two equivalent transpositions:
    # (a b, c) -> (c, a b) can be LXRX or XLXR depending on chirality/view
    # and vice versa.
    t1 = 'LXRX' if pattern == 0 else 'RXXL'
    t2 = 'XLXR' if pattern == 0 else 'XRXR'
    for ch in word:
        if ch == 'L':
            out.append('LL' if a[c] == m else 'L')
            c = (c + 1) % n
        elif ch == 'R':
            c = (c - 1) % n
            out.append('RR' if a[c] == m else 'R')
        else:
            c2 = (c + 1) % n
            out.append(t1 if a[c] == m else t2 if a[c2] == m else 'X')
            a[c], a[c2] = a[c2], a[c]
    return ''.join(out)


def _reduce(word):
    out = []
    for ch in word:
        if out and out[-1] + ch in ('LR', 'RL'):
            out.pop()
        elif len(out) >= 1 and ch == 'X' and out[-1] == 'X':
            out.pop()
        else:
            out.append(ch)
    return ''.join(out)


def gadget(instance, parent_word, direction='short', align_dir='short'):
    m = instance['m']
    child = instance['child']['unit_base']
    n = len(child)
    pos, split = instance['insert']['position'], instance['insert']['split']
    p = child.index(m + 1)
    
    # Head rotation
    if align_dir == 'left':
        head = 'L' * p
    elif align_dir == 'right':
        head = 'R' * ((n - p) % n)
    else:
        head = 'L' * p if p <= n - p else 'R' * (n - p)
        
    v = _rot(child, head)
    q = v.index(m)
    
    if direction == 'short':
        right = q <= n - 1 - q
    elif direction == 'right':
        right = True
    elif direction == 'left':
        right = False
    else:
        right = True
        
    move = 'XL' * q if right else 'RX' * (n - 1 - q)
    v = _rot(v, move)
    
    base, word = _lifted(instance['parent']['unit_base'], parent_word, pos if split == 'both' else None)
    pair = []
    for x in base:
        pair.extend([m, m + 1] if x == m else [x])
    shifts = [s for s in range(n) if v[s:] + v[:s] == pair]
    if not shifts:
        return None
    s = shifts[0]
    
    if align_dir == 'left':
        align = 'L' * s
    elif align_dir == 'right':
        align = 'R' * ((n - s) % n)
    else:
        align = 'L' * s if s <= n - s else 'R' * (n - s)
        
    pw = _pair_word(base, word, m)
    cand = _reduce(head + move + align + pw)
    
    # Verify candidate correctly sorts child unit base
    check = _rot(child, cand)
    target = list(range(1, m + 2)) + [0] * (n - (m + 1))
    if check == target:
        return cand
    return None


def lift(instance):
    rows = instance['parent']['certificate']['rows']
    configs = [
        ('short', 'short'),
        ('right', 'short'),
        ('left', 'short'),
        ('short', 'left'),
        ('short', 'right'),
        ('right', 'right'),
        ('left', 'left'),
    ]
    
    words = []
    for direction, align_dir in configs:
        for r in rows:
            w = gadget(instance, r['word'], direction=direction, align_dir=align_dir)
            if w and w not in words:
                words.append(w)
                if len(words) >= 16:
                    return {'words': words}
                    
    # Fallback to ensure at least one word is returned
    if not words:
        for r in rows:
            w = gadget(instance, r['word'])
            if w and w not in words:
                words.append(w)
                
    return {'words': words}
